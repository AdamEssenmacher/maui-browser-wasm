<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <DefaultWasmHostConfig>browser</DefaultWasmHostConfig>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableJSImport>true</WasmEnableJSImport>
    <WasmBuildAppBundle>true</WasmBuildAppBundle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DOTNET_WATCH)' == '1'">
    <BuildInParallel>false</BuildInParallel>
    <RestoreBuildInParallel>false</RestoreBuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <HostConfig Include="browser">
      <host>browser</host>
      <html-path>index.html</html-path>
    </HostConfig>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mirage.Maui\Mirage.Maui.csproj" />
    <ProjectReference Include="..\..\src\Mirage.Provider.Fast\Mirage.Provider.Fast.csproj" />
    <ProjectReference Include="..\..\src\Mirage.Web\Mirage.Web.csproj" />
    <ProjectReference Include="..\..\src\Mirage.Core\Mirage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="App\CounterPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="$(MauiPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot\**\*.*">
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </WasmExtraFilesToDeploy>
  </ItemGroup>

  <ItemGroup>
    <Watch Include="$(MSBuildProjectDirectory)\App\CounterPage.xaml">
      <StaticWebAssetPath>/_hotreload/CounterPage.xaml</StaticWebAssetPath>
    </Watch>
  </ItemGroup>

  <Target Name="SyncMirageDomModule" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\_framework" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\src\Mirage.Web\wwwroot\mirage-dom.js"
          DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\_framework\mirage-dom.js"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
