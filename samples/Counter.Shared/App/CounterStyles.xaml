<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Counter.Shared.App.CounterStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="CounterInkColor">#0F172A</Color>
    <Color x:Key="CounterMutedColor">#334155</Color>
    <Color x:Key="CounterSurfaceColor">#E6FFFFFF</Color>
    <Color x:Key="CounterActionBackgroundColor">#DBEAFE</Color>
    <Color x:Key="CounterActionBorderColor">#6B7280</Color>

    <Style x:Key="CounterRootPageStyle" TargetType="ContentPage">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <GradientStop Color="#F8FAFC" Offset="0.0" />
                    <GradientStop Color="#E2E8F0" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CounterRootStackStyle" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="BackgroundColor" Value="{StaticResource CounterSurfaceColor}" />
    </Style>

    <Style x:Key="CounterTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextColor" Value="{StaticResource CounterInkColor}" />
    </Style>

    <Style x:Key="CounterSubtitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextColor" Value="{StaticResource CounterMutedColor}" />
    </Style>

    <Style x:Key="CounterBodyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextColor" Value="{StaticResource CounterInkColor}" />
    </Style>

    <Style x:Key="CounterCountLabelStyle" TargetType="Label" BasedOn="{StaticResource CounterBodyLabelStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CounterEntryStyle" TargetType="Entry">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="TextColor" Value="{StaticResource CounterInkColor}" />
        <Setter Property="BackgroundColor" Value="#FFFFFF" />
    </Style>

    <Style x:Key="CounterButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="BackgroundColor" Value="{StaticResource CounterActionBackgroundColor}" />
        <Setter Property="BorderColor" Value="{StaticResource CounterActionBorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="TextColor" Value="{StaticResource CounterInkColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

</ResourceDictionary>
