<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Counter.Shared.App.CounterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    AutomationId="counter-page-root"
    Style="{StaticResource CounterRootPageStyle}">

    <VerticalStackLayout
        x:Name="CounterStack"
        AutomationId="counter-stack"
        Style="{StaticResource CounterRootStackStyle}">
        <Label
            x:Name="CounterTitle"
            AutomationId="counter-title"
            Style="{StaticResource CounterTitleLabelStyle}"
            Text="Mirage Counter Sample" />
        <Label
            x:Name="CounterSubtitle"
            AutomationId="counter-subtitle"
            Style="{StaticResource CounterSubtitleLabelStyle}"
            Text="Type into Entry and click Increment." />
        <Entry
            x:Name="CounterEntry"
            AutomationId="counter-entry"
            Placeholder="Type here"
            Style="{StaticResource CounterEntryStyle}"
            Text="{Binding InputText, Mode=TwoWay}" />
        <Label
            x:Name="LiveLabel"
            AutomationId="counter-live-label"
            Style="{StaticResource CounterBodyLabelStyle}"
            Text="{Binding LiveText}" />
        <Button
            x:Name="IncrementButton"
            AutomationId="counter-button"
            Command="{Binding IncrementCommand}"
            Style="{StaticResource CounterButtonStyle}"
            Text="Increment" />
        <Label
            x:Name="CountLabel"
            AutomationId="counter-count-label"
            Style="{StaticResource CounterCountLabelStyle}"
            Text="{Binding CountText}" />
    </VerticalStackLayout>
</ContentPage>
