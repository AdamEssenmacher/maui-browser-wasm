<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <MirageBrowserApp>true</MirageBrowserApp>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <DefaultWasmHostConfig>browser</DefaultWasmHostConfig>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableJSImport>true</WasmEnableJSImport>
    <WasmBuildAppBundle>true</WasmBuildAppBundle>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ControlsSampleVendorRoot>..\..\vendor\upstream\controls-sample\</ControlsSampleVendorRoot>
  </PropertyGroup>

  <ItemGroup>
    <HostConfig Include="browser">
      <host>browser</host>
      <html-path>index.html</html-path>
    </HostConfig>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mirage.Maui\Mirage.Maui.csproj" />
    <ProjectReference Include="..\..\src\Mirage.Provider.Fluent\Mirage.Provider.Fluent.csproj" />
    <ProjectReference Include="..\..\src\Mirage.Web\Mirage.Web.csproj" />
    <ProjectReference Include="..\..\src\Mirage.Core\Mirage.Core.csproj" />
    <ProjectReference Include="..\ControlsSample.Shared\ControlsSample.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MirageHotReloadXaml Include="..\ControlsSample.Shared\App\**\*.xaml">
      <HotReloadAssemblyName>ControlsSample.Shared</HotReloadAssemblyName>
      <HotReloadRelativePath>App/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\\', '/'))</HotReloadRelativePath>
    </MirageHotReloadXaml>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="$(MauiPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <MauiFont Include="$(ControlsSampleVendorRoot)Resources\Fonts\*.ttf" />
    <MauiAsset Include="$(ControlsSampleVendorRoot)Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*.*" Exclude="wwwroot\_hotreload\**\*.*;wwwroot\_mirage\assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot\**\*.*" Exclude="wwwroot\_hotreload\**\*.*;wwwroot\_mirage\assets\**\*.*">
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </WasmExtraFilesToDeploy>
  </ItemGroup>
</Project>
