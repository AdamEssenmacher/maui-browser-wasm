<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Showcase.Shared.App.ShowcaseHeroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    AutomationId="showcase-root"
    Style="{StaticResource ShowcaseRootPageStyle}">

    <Grid
        AutomationId="showcase-page-grid"
        ColumnDefinitions="*"
        RowDefinitions="*">
        <ScrollView
            x:Name="ShowcaseScrollRoot"
            AutomationId="showcase-scroll-root"
            Orientation="Vertical">
            <VerticalStackLayout
                AutomationId="hero-page-stack"
                HorizontalOptions="Center"
                MaximumWidthRequest="1040"
                Style="{StaticResource ShowcasePageRootStackStyle}">

                <VerticalStackLayout
                    AutomationId="hero"
                    Style="{StaticResource ShowcaseSectionCardStyle}"
                    Spacing="10">
                    <Label
                        AutomationId="hero-kicker"
                        Style="{StaticResource ShowcaseKickerLabelStyle}"
                        Text="Mirage" />
                    <Label
                        AutomationId="hero-headline"
                        Style="{StaticResource ShowcaseHeadlineLabelStyle}"
                        Text="Run .NET MAUI apps in the browser — with real DOM UI." />
                    <Label
                        AutomationId="hero-subheadline"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Mirage is a semantic runtime that brings .NET MAUI to the browser by rendering your UI as actual DOM elements and Web Components using pluggable component providers." />
                    <Label
                        AutomationId="hero-description"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Build your UI once with MAUI and run it directly in the browser without rewriting your UI layer." />
                    <Label
                        AutomationId="hero-tagline-primary"
                        Style="{StaticResource ShowcaseTaglineLabelStyle}"
                        Text="MAUI UI, rendered as real web UI." />
                </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="hero-cta"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <HorizontalStackLayout
                AutomationId="hero-cta-row"
                Spacing="10">
                <Button
                    AutomationId="hero-cta-demo"
                    Clicked="OnDemoCtaClicked"
                    Text="Try the Live Demo" />
                <Button
                    AutomationId="hero-cta-command-layout-lab"
                    Clicked="OnCommandScrollToLayoutLabClicked"
                    Text="Open Layout Lab" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="showcase-navigation-lab-preview"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <Label
                AutomationId="showcase-navigation-lab-preview-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Navigation Projection Lab" />
            <Label
                AutomationId="showcase-navigation-lab-preview-body"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="NavigationPage remains the source of truth. Mirage projects stack changes into browser URLs and history." />
            <Label
                AutomationId="showcase-navigation-lab-preview-routes"
                Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}"
                Text="Routes: /, /navigation-lab, /projects/{id}" />
            <HorizontalStackLayout Spacing="10">
                <Button
                    AutomationId="showcase-open-navigation-lab"
                    Clicked="OnOpenNavigationLabPageClicked"
                    Style="{StaticResource ShowcaseLabActionButtonStyle}"
                    Text="Open Navigation Lab" />
                <Button
                    AutomationId="showcase-open-project-route"
                    Clicked="OnOpenProjectRoutePageClicked"
                    Style="{StaticResource ShowcaseLabActionButtonStyle}"
                    Text="Open /projects/42" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout
            x:Name="DemoSection"
            AutomationId="demo"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <Label
                AutomationId="demo-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Live Mirage Demo" />
            <Label
                AutomationId="showcase-demo-your-name-label"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Your name:" />
            <Entry
                AutomationId="showcase-demo-entry"
                Placeholder="Type your name"
                Text="{Binding Name, Mode=TwoWay}" />
            <Label
                AutomationId="showcase-demo-greeting"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="{Binding Greeting}" />
            <Button
                AutomationId="showcase-demo-button"
                Command="{Binding ClickCommand}"
                Text="Click Me" />
            <Label
                AutomationId="showcase-demo-count"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="{Binding ClickCountText}" />
            <Label
                AutomationId="showcase-demo-powered-by"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Powered by Mirage + Fluent UI Web Components" />
            <Label
                AutomationId="showcase-demo-devtools-hint"
                Style="{StaticResource ShowcaseTaglineLabelStyle}"
                Text="Open DevTools and inspect this page. The UI is rendered as real Fluent UI Web Components and DOM elements." />
            <Label
                AutomationId="showcase-generic-demo-title"
                Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                Text="Generic WebNode Demo" />
            <ContentView
                x:Name="GenericWidgetHost"
                AutomationId="showcase-generic-widget-host" />
            <Label
                AutomationId="showcase-generic-widget-count"
                Text="{Binding GenericWidgetClicksText}" />
        </VerticalStackLayout>

        <ContentView
            x:Name="ProvidersSection"
            AutomationId="providers">
            <VerticalStackLayout
                AutomationId="providers-content"
                Style="{StaticResource ShowcaseSectionCardStyle}"
                Spacing="12">
                <Label
                    AutomationId="providers-title"
                    Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                    Text="Feature Highlights" />

                <VerticalStackLayout
                    AutomationId="showcase-feature-dom"
                    Style="{StaticResource ShowcaseFeatureCardStyle}"
                    Spacing="4">
                    <Label
                        AutomationId="showcase-feature-dom-title"
                        Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                        Text="Real DOM Rendering" />
                    <Label
                        AutomationId="showcase-feature-dom-body"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Mirage renders UI as real DOM elements and Web Components. Use standard browser tooling to inspect, debug, and style your app." />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="showcase-feature-maui"
                    Style="{StaticResource ShowcaseFeatureCardStyle}"
                    Spacing="4">
                    <Label
                        AutomationId="showcase-feature-maui-title"
                        Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                        Text="MAUI Programming Model" />
                    <Label
                        AutomationId="showcase-feature-maui-body"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Write UI with MAUI controls and layouts. Mirage translates them into semantic UI and renders them in the browser." />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="showcase-feature-providers"
                    Style="{StaticResource ShowcaseFeatureCardStyle}"
                    Spacing="4">
                    <Label
                        AutomationId="showcase-feature-providers-title"
                        Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                        Text="Pluggable Component Providers" />
                    <Label
                        AutomationId="showcase-feature-providers-body"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Mirage separates UI semantics from rendering. Fluent UI Web Components is the first polished reference provider (built on FAST foundations), and the architecture is designed for providers such as UI5 and custom design systems." />
                </VerticalStackLayout>

                <Label
                    AutomationId="showcase-tagline-secondary"
                    Style="{StaticResource ShowcaseTaglineLabelStyle}"
                    Text="MAUI UI, rendered as real web UI." />
            </VerticalStackLayout>
        </ContentView>

        <VerticalStackLayout
            x:Name="LayoutLabSection"
            AutomationId="layout-lab"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="10">
            <Label
                AutomationId="layout-lab-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Layout Lab" />
            <Label
                AutomationId="layout-lab-body"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Container sizing, constraints, and positioning correctness across ContentView, stack layouts, Grid, and nested layout contexts." />
            <Button
                AutomationId="layout-lab-scroll-command-top"
                Clicked="OnLayoutLabScrollToTopClicked"
                HorizontalOptions="Start"
                Style="{StaticResource ShowcaseLabActionButtonStyle}"
                Text="Command Scroll To Top" />
            <Label
                AutomationId="layout-lab-scroll-command-count"
                Style="{StaticResource ShowcaseMutedSmallLabelStyle}"
                Text="{Binding LayoutLabScrollCommandCountText}" />

            <VerticalStackLayout
                AutomationId="layout-lab-group-content-view"
                Style="{StaticResource ShowcaseLayoutLabGroupCardStyle}"
                Spacing="8">
                <Label
                    AutomationId="layout-lab-group-content-view-title"
                    Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                    Text="Group A — ContentView parent scenarios" />
                <Grid
                    AutomationId="layout-lab-matrix-content-view"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    Style="{StaticResource ShowcaseLayoutLabMatrixStyle}">
                    <ContentView
                        AutomationId="layout-lab-card-content-view-fixed-centered"
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Fixed-size parent, centered child" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: ContentView | Parent Size: 320x180 | Child: ContentView | Child Config: HorizontalOptions=Center, VerticalOptions=Center" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-fixed-centered"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Child stays centered within fixed parent bounds and retains explicit requested size." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-fixed-centered"
                                HeightRequest="180"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <ContentView
                                    AutomationId="layout-lab-child-content-view-fixed-centered-primary"
                                    HeightRequest="56"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}"
                                    VerticalOptions="Center"
                                    WidthRequest="140" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-fixed-stretch"
                        Grid.Column="1"
                        Grid.Row="0"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Fixed-size parent, stretched child" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: ContentView | Parent Size: 320x180 | Child: ContentView | Child Config: HorizontalOptions=Fill, VerticalOptions=Fill" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-fixed-stretch"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Child stretches to the parent content surface on both axes." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-fixed-stretch"
                                HeightRequest="180"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <ContentView
                                    AutomationId="layout-lab-child-content-view-fixed-stretch-primary"
                                    HorizontalOptions="Fill"
                                    Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}"
                                    VerticalOptions="Fill">
                                    <Label Text="Stretch probe" />
                                </ContentView>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-explicit-size-request"
                        Grid.Column="0"
                        Grid.Row="1"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Explicit Width/Height request" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: ContentView | Parent Size: 320x180 | Child: Entry | Child Config: WidthRequest=220, HeightRequest=44" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-explicit-size-request"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Explicit child width/height request is honored within parent bounds." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-explicit-size-request"
                                HeightRequest="180"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <Entry
                                    AutomationId="layout-lab-child-content-view-explicit-size-request-primary"
                                    HeightRequest="44"
                                    HorizontalOptions="Start"
                                    Placeholder="Sized entry probe"
                                    WidthRequest="220" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-margin-interaction"
                        Grid.Column="1"
                        Grid.Row="1"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Child margin interaction" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: ContentView | Parent Size: 320x180 | Child: Button | Child Config: Margin=18,12,16,10" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-margin-interaction"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Margin offsets the child within fixed bounds while preserving child size." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-margin-interaction"
                                HeightRequest="180"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <Button
                                    AutomationId="layout-lab-child-content-view-margin-interaction-primary"
                                    HorizontalOptions="Start"
                                    Margin="18,12,16,10"
                                    Text="Margin probe" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-visibility-hidden"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="2"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Hidden child participation" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: ContentView | Parent Size: 320x180 | Child: Label | Child Config: IsVisible=false" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-visibility-hidden"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Hidden child is not rendered while visible sibling marker remains shown." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-visibility-hidden"
                                HeightRequest="180"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        AutomationId="layout-lab-child-content-view-visibility-hidden-primary"
                                        IsVisible="False"
                                        Text="Hidden child probe" />
                                    <Label Text="Visible sibling marker" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="layout-lab-group-vertical-stack"
                Style="{StaticResource ShowcaseLayoutLabGroupCardStyle}"
                Spacing="8">
                <Label
                    AutomationId="layout-lab-group-vertical-stack-title"
                    Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                    Text="Group B — VerticalStackLayout parent scenarios" />
                <Grid
                    AutomationId="layout-lab-matrix-vertical-stack"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    Style="{StaticResource ShowcaseLayoutLabMatrixStyle}">
                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-multi-child-spacing"
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Multiple children + spacing" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: Label x3 | Child Config: Spacing=14" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-multi-child-spacing"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Children stack top-to-bottom with consistent vertical gap." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-multi-child-spacing"
                                HeightRequest="220"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="14">
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-multi-child-spacing-primary"
                                        Text="Stack item A" />
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-multi-child-spacing-secondary"
                                        Text="Stack item B" />
                                    <Label Text="Stack item C" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-stretch-cross-axis"
                        Grid.Column="1"
                        Grid.Row="0"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Stretch on cross-axis" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: ContentView x2 | Child Config: no WidthRequest" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-stretch-cross-axis"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Child probes stretch horizontally across vertical stack content width." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-stretch-cross-axis"
                                HeightRequest="220"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="10">
                                    <ContentView
                                        AutomationId="layout-lab-child-vertical-stack-stretch-cross-axis-primary"
                                        HeightRequest="44"
                                        Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}">
                                        <Label Text="Stretch A" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="44"
                                        Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}">
                                        <Label Text="Stretch B" />
                                    </ContentView>
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-centered-child"
                        Grid.Column="0"
                        Grid.Row="1"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Centered child alignment" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: ContentView | Child Config: HorizontalOptions=Center" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-centered-child"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Child stays centered horizontally while preserving natural height." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-centered-child"
                                HeightRequest="220"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="10">
                                    <ContentView
                                        AutomationId="layout-lab-child-vertical-stack-centered-child-primary"
                                        HeightRequest="52"
                                        HorizontalOptions="Center"
                                        Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}"
                                        WidthRequest="150">
                                        <Label Text="Centered child" />
                                    </ContentView>
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-explicit-size-and-margin"
                        Grid.Column="1"
                        Grid.Row="1"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Explicit size + margin" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: ContentView | Child Config: WidthRequest=140, HeightRequest=56, Margin=20,8,0,8" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-explicit-size-and-margin"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Requested size and margin are honored in stacked flow." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-explicit-size-and-margin"
                                HeightRequest="220"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="8">
                                    <ContentView
                                        AutomationId="layout-lab-child-vertical-stack-explicit-size-and-margin-primary"
                                        HeightRequest="56"
                                        Margin="20,8,0,8"
                                        Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}"
                                        WidthRequest="140">
                                        <Label Text="Sized + margin" />
                                    </ContentView>
                                    <Label Text="Sibling below probe" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-hidden-child-collapse"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="2"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Hidden child collapse participation" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: Label x3 | Child Config: middle IsVisible=false" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-hidden-child-collapse"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Hidden middle child collapses and does not consume stack spacing." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-hidden-child-collapse"
                                HeightRequest="220"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="14">
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-hidden-child-collapse-first"
                                        Text="Visible item A" />
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-hidden-child-collapse-primary"
                                        IsVisible="False"
                                        Text="Hidden item B" />
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-hidden-child-collapse-third"
                                        Text="Visible item C" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="layout-lab-group-horizontal-stack"
                Style="{StaticResource ShowcaseLayoutLabGroupCardStyle}"
                Spacing="8">
                <Label
                    AutomationId="layout-lab-group-horizontal-stack-title"
                    Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                    Text="Group C — HorizontalStackLayout parent scenarios" />
                <Grid
                    AutomationId="layout-lab-matrix-horizontal-stack"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    Style="{StaticResource ShowcaseLayoutLabMatrixStyle}">
                    <ContentView
                        AutomationId="layout-lab-card-horizontal-stack-multi-child-spacing"
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Multiple children + spacing" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: HorizontalStackLayout | Parent Size: 360x130 | Child: ContentView x3 | Child Config: Spacing=12" />
                            <Label
                                AutomationId="layout-lab-expected-horizontal-stack-multi-child-spacing"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Children flow left-to-right with consistent horizontal spacing." />
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-multi-child-spacing"
                                HeightRequest="130"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="360">
                                <HorizontalStackLayout Spacing="12">
                                    <ContentView
                                        AutomationId="layout-lab-child-horizontal-stack-multi-child-spacing-primary"
                                        HeightRequest="66"
                                        Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}"
                                        WidthRequest="96">
                                        <Label Text="Row A" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="66"
                                        Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}"
                                        WidthRequest="96">
                                        <Label Text="Row B" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="66"
                                        Style="{StaticResource ShowcaseLayoutLabProbeSurfaceStyle}"
                                        WidthRequest="96">
                                        <Label Text="Row C" />
                                    </ContentView>
                                </HorizontalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-horizontal-stack-constrained-width-overflow"
                        Grid.Column="1"
                        Grid.Row="0"
                        Style="{StaticResource ShowcaseLayoutLabScenarioCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}" Text="Constrained width overflow" />
                            <Label Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}" Text="Parent: HorizontalStackLayout | Parent Size: 280x130 | Child: ContentView x2 | Child Config: WidthRequest=220 each" />
                            <Label
                                AutomationId="layout-lab-expected-horizontal-stack-constrained-width-overflow"
                                Style="{StaticResource ShowcaseLayoutLabExpectedLabelStyle}"
                                Text="Expected: Both hosts keep requested child width under tight bounds; clipped host hides overflow while unclipped host exposes it." />
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-constrained-width-overflow"
                                HeightRequest="130"
                                Style="{StaticResource ShowcaseLayoutLabParentSurfaceStyle}"
                                WidthRequest="280">
                                <HorizontalStackLayout
                                    AutomationId="layout-lab-overflow-host-horizontal-unclipped"
                                    Spacing="8">
                                    <ContentView
