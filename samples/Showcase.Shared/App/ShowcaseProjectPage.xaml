<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Showcase.Shared.App.ShowcaseProjectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    AutomationId="showcase-page-project"
    Title="Project">
    <ScrollView
        AutomationId="showcase-project-scroll-root"
        Orientation="Vertical">
        <VerticalStackLayout
            AutomationId="showcase-project-root"
            HorizontalOptions="Center"
            MaximumWidthRequest="980"
            Style="{StaticResource ShowcasePageRootStackStyle}">
            <VerticalStackLayout
                AutomationId="showcase-project-card"
                Style="{StaticResource ShowcaseSectionCardStyle}"
                Spacing="10">
                <Label
                    AutomationId="showcase-project-title"
                    Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                    Text="Project Details" />
                <Label
                    x:Name="ProjectIdLabel"
                    AutomationId="showcase-project-id"
                    Style="{StaticResource ShowcaseTaglineLabelStyle}"
                    Text="Project: (unset)" />
                <Label
                    x:Name="ProjectRouteLabel"
                    AutomationId="showcase-project-route"
                    Style="{StaticResource ShowcaseLayoutLabConfigLabelStyle}"
                    Text="Route: /projects/(unset)" />
                <Label
                    AutomationId="showcase-project-body"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="This page is activated from route templates. Refresh and browser navigation should preserve the visible page route." />

                <HorizontalStackLayout Spacing="10">
                    <Button
                        AutomationId="showcase-project-push-next"
                        Clicked="OnPushNextClicked"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="Push Next Project" />
                    <Button
                        AutomationId="showcase-project-open-navigation-lab"
                        Clicked="OnOpenNavigationLabClicked"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="Open Navigation Lab" />
                    <Button
                        AutomationId="showcase-project-pop"
                        Clicked="OnPopClicked"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="Pop" />
                    <Button
                        AutomationId="showcase-project-pop-to-root"
                        Clicked="OnPopToRootClicked"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="Pop To Root" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
