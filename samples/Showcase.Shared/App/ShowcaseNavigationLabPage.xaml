<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Showcase.Shared.App.ShowcaseNavigationLabPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    AutomationId="showcase-page-navigation-lab"
    Title="Navigation Lab">
    <ScrollView
        AutomationId="showcase-navigation-lab-scroll-root"
        Orientation="Vertical">
        <VerticalStackLayout
            AutomationId="showcase-navigation-lab-root"
            HorizontalOptions="Center"
            MaximumWidthRequest="980">
            <VerticalStackLayout
                AutomationId="showcase-navigation-lab-card"
                Spacing="10">
                <Label
                    AutomationId="showcase-navigation-lab-title"
                    Style="{StaticResource Headline}"
                    Text="Navigation Lab" />
                <Label
                    AutomationId="showcase-navigation-lab-summary"
                    Text="This page proves NavigationPage-first browser routing. Push/pop changes update URL/history while MAUI stack semantics remain the source of truth." />
                <Label
                    AutomationId="showcase-navigation-lab-route"
                    Text="Route: /navigation-lab" />
                <Label
                    x:Name="NavigationLabTitleStateLabel"
                    AutomationId="showcase-navigation-lab-title-state"
                    Text="Visible title: Navigation Lab" />
                <Label
                    x:Name="NavigationLabBarStateLabel"
                    AutomationId="showcase-navigation-lab-bar-state"
                    Text="Nav bar visible: True" />
                <Label
                    x:Name="NavigationLabBackStateLabel"
                    AutomationId="showcase-navigation-lab-back-state"
                    Text="Back button allowed: True" />
                <Label
                    x:Name="NavigationLabToolbarCountLabel"
                    AutomationId="showcase-navigation-lab-toolbar-count"
                    Text="Toolbar command count: 0" />

                <HorizontalStackLayout Spacing="10">
                    <Button
                        AutomationId="navigation-lab-push-project-101"
                        Clicked="OnPushProject101Clicked"
                        Text="Push Project 101" />
                    <Button
                        AutomationId="navigation-lab-push-project-202"
                        Clicked="OnPushProject202Clicked"
                        Text="Push Project 202" />
                    <Button
                        AutomationId="navigation-lab-pop"
                        Clicked="OnPopClicked"
                        Text="Pop" />
                    <Button
                        AutomationId="navigation-lab-pop-to-root"
                        Clicked="OnPopToRootClicked"
                        Text="Pop To Root" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <Button
                        AutomationId="navigation-lab-toggle-nav-bar"
                        Clicked="OnToggleNavigationBarClicked"
                        Text="Toggle Nav Bar" />
                    <Button
                        AutomationId="navigation-lab-toggle-back-button"
                        Clicked="OnToggleBackButtonClicked"
                        Text="Toggle Back Button" />
                    <Button
                        AutomationId="navigation-lab-bump-title"
                        Clicked="OnBumpTitleClicked"
                        Text="Retitle Page" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="showcase-navigation-lab-notes"
                Spacing="6">
                <Label
                    AutomationId="showcase-navigation-lab-note-title"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Text="Expected Behavior" />
                <Label
                    AutomationId="showcase-navigation-lab-note-stack"
                    Text="PushAsync/PopAsync drive the MAUI NavigationPage stack first." />
                <Label
                    AutomationId="showcase-navigation-lab-note-projection"
                    Text="Mirage projects the visible page into browser URL/history and synchronizes browser back/forward back into stack changes." />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
