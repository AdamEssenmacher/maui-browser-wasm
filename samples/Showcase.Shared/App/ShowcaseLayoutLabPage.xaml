<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Showcase.Shared.App.ShowcaseLayoutLabPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    AutomationId="showcase-page-layout-lab"
    Title="Layout Lab">
    <ScrollView
        x:Name="LayoutLabScrollRoot"
        AutomationId="layout-lab-scroll-root"
        Orientation="Vertical">
        <VerticalStackLayout
            AutomationId="layout-lab-page-stack"
            HorizontalOptions="Center"
            MaximumWidthRequest="1040"
            Style="{StaticResource ShowcasePageStack}">
        <ContentView Style="{StaticResource ShowcaseSectionCardFrame}">
            <VerticalStackLayout
                x:Name="LayoutLabSection"
                AutomationId="layout-lab"
                Style="{StaticResource ShowcaseSectionCardBody}">
            <Label
                AutomationId="layout-lab-title"
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Start"
                HorizontalTextAlignment="Start"
                Text="Layout Lab" />
            <Grid
                x:Name="LayoutLabSquareProbe"
                AutomationId="layout-lab-square-probe"
                HeightRequest="{Binding Width, Source={RelativeSource Self}}"
                BackgroundColor="White">
                <Grid HeightRequest="20"
                      WidthRequest="20"
                      BackgroundColor="Green" />
            </Grid>
            <Grid
                x:Name="LayoutLabSquareProbeXReference"
                AutomationId="layout-lab-square-probe-xreference"
                HeightRequest="{Binding Source={x:Reference LayoutLabSquareProbeXReference}, Path=Width}"
                BackgroundColor="White">
                <Grid HeightRequest="20"
                      WidthRequest="20"
                      BackgroundColor="Blue" />
            </Grid>
            <Button
                AutomationId="layout-lab-scroll-command-top"
                Clicked="OnLayoutLabScrollToTopClicked"
                HorizontalOptions="Start"
                Text="Command Scroll To Top" />
            <Label
                AutomationId="layout-lab-scroll-command-count"
                Text="{Binding LayoutLabScrollCommandCountText}" />

            <VerticalStackLayout
                AutomationId="layout-lab-group-content-view"
                Spacing="8">
                <Label
                    AutomationId="layout-lab-group-content-view-title"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Text="Group A — ContentView parent scenarios" />
                <Grid
                    AutomationId="layout-lab-matrix-content-view"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto">
                    <ContentView
                        AutomationId="layout-lab-card-content-view-fixed-centered"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Fixed-size parent, centered child" />
                            <Label Text="Parent: ContentView | Parent Size: 320x180 | Child: ContentView | Child Config: HorizontalOptions=Center, VerticalOptions=Center" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-fixed-centered"
                                Text="Expected: Child stays centered within fixed parent bounds and retains explicit requested size." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-fixed-centered"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="180"
                                WidthRequest="320">
                                <ContentView
                                    AutomationId="layout-lab-child-content-view-fixed-centered-primary"
                                    StyleClass="showcase-layout-child-probe"
                                    HeightRequest="56"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    WidthRequest="140" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-fixed-stretch"
                        Grid.Column="1"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Fixed-size parent, stretched child" />
                            <Label Text="Parent: ContentView | Parent Size: 320x180 | Child: ContentView | Child Config: HorizontalOptions=Fill, VerticalOptions=Fill" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-fixed-stretch"
                                Text="Expected: Child stretches to the parent content surface on both axes." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-fixed-stretch"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="180"
                                WidthRequest="320">
                                <ContentView
                                    AutomationId="layout-lab-child-content-view-fixed-stretch-primary"
                                    StyleClass="showcase-layout-child-probe"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">
                                    <Label Text="Stretch probe" />
                                </ContentView>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-explicit-size-request"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.Row="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Explicit Width/Height request" />
                            <Label Text="Parent: ContentView | Parent Size: 320x180 | Child: Entry | Child Config: WidthRequest=220, HeightRequest=44" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-explicit-size-request"
                                Text="Expected: Explicit child width/height request is honored within parent bounds." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-explicit-size-request"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="180"
                                WidthRequest="320">
                                <Entry
                                    AutomationId="layout-lab-child-content-view-explicit-size-request-primary"
                                    StyleClass="showcase-layout-child-probe"
                                    HeightRequest="44"
                                    HorizontalOptions="Start"
                                    Placeholder="Sized entry probe"
                                    WidthRequest="220" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-margin-interaction"
                        Grid.Column="1"
                        StyleClass="showcase-layout-card"
                        Grid.Row="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Child margin interaction" />
                            <Label Text="Parent: ContentView | Parent Size: 320x180 | Child: Button | Child Config: Margin=18,12,16,10" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-margin-interaction"
                                Text="Expected: Margin offsets the child within fixed bounds while preserving child size." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-margin-interaction"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="180"
                                WidthRequest="320">
                                <Button
                                    AutomationId="layout-lab-child-content-view-margin-interaction-primary"
                                    StyleClass="showcase-layout-child-probe"
                                    HorizontalOptions="Start"
                                    Margin="18,12,16,10"
                                    Text="Margin probe" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-content-view-visibility-hidden"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.ColumnSpan="2"
                        Grid.Row="2">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Hidden child participation" />
                            <Label Text="Parent: ContentView | Parent Size: 320x180 | Child: Label | Child Config: IsVisible=false" />
                            <Label
                                AutomationId="layout-lab-expected-content-view-visibility-hidden"
                                Text="Expected: Hidden child is not rendered while visible sibling marker remains shown." />
                            <ContentView
                                AutomationId="layout-lab-parent-content-view-visibility-hidden"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="180"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        AutomationId="layout-lab-child-content-view-visibility-hidden-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        IsVisible="False"
                                        Text="Hidden child probe" />
                                    <Label Text="Visible sibling marker" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="layout-lab-group-vertical-stack"
                Spacing="8">
                <Label
                    AutomationId="layout-lab-group-vertical-stack-title"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Text="Group B — VerticalStackLayout parent scenarios" />
                <Grid
                    AutomationId="layout-lab-matrix-vertical-stack"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto">
                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-multi-child-spacing"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Multiple children + spacing" />
                            <Label Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: Label x3 | Child Config: Spacing=14" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-multi-child-spacing"
                                Text="Expected: Children stack top-to-bottom with consistent vertical gap." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-multi-child-spacing"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="220"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="14">
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-multi-child-spacing-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        Text="Stack item A" />
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-multi-child-spacing-secondary"
                                    StyleClass="showcase-layout-child-probe"
                                        Text="Stack item B" />
                                    <Label Text="Stack item C" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-stretch-cross-axis"
                        Grid.Column="1"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Stretch on cross-axis" />
                            <Label Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: ContentView x2 | Child Config: no WidthRequest" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-stretch-cross-axis"
                                Text="Expected: Child probes stretch horizontally across vertical stack content width." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-stretch-cross-axis"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="220"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="10">
                                    <ContentView
                                        AutomationId="layout-lab-child-vertical-stack-stretch-cross-axis-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        HeightRequest="44">
                                        <Label Text="Stretch A" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="44">
                                        <Label Text="Stretch B" />
                                    </ContentView>
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-centered-child"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.Row="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Centered child alignment" />
                            <Label Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: ContentView | Child Config: HorizontalOptions=Center" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-centered-child"
                                Text="Expected: Child stays centered horizontally while preserving natural height." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-centered-child"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="220"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="10">
                                    <ContentView
                                        AutomationId="layout-lab-child-vertical-stack-centered-child-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        HeightRequest="52"
                                        HorizontalOptions="Center"
                                        WidthRequest="150">
                                        <Label Text="Centered child" />
                                    </ContentView>
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-explicit-size-and-margin"
                        Grid.Column="1"
                        StyleClass="showcase-layout-card"
                        Grid.Row="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Explicit size + margin" />
                            <Label Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: ContentView | Child Config: WidthRequest=140, HeightRequest=56, Margin=20,8,0,8" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-explicit-size-and-margin"
                                Text="Expected: Requested size and margin are honored in stacked flow." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-explicit-size-and-margin"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="220"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="8">
                                    <ContentView
                                        AutomationId="layout-lab-child-vertical-stack-explicit-size-and-margin-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        HeightRequest="56"
                                        Margin="20,8,0,8"
                                        WidthRequest="140">
                                        <Label Text="Sized + margin" />
                                    </ContentView>
                                    <Label Text="Sibling below probe" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-vertical-stack-hidden-child-collapse"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.ColumnSpan="2"
                        Grid.Row="2">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Hidden child collapse participation" />
                            <Label Text="Parent: VerticalStackLayout | Parent Size: 320x220 | Child: Label x3 | Child Config: middle IsVisible=false" />
                            <Label
                                AutomationId="layout-lab-expected-vertical-stack-hidden-child-collapse"
                                Text="Expected: Hidden middle child collapses and does not consume stack spacing." />
                            <ContentView
                                AutomationId="layout-lab-parent-vertical-stack-hidden-child-collapse"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="220"
                                WidthRequest="320">
                                <VerticalStackLayout Spacing="14">
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-hidden-child-collapse-first"
                                    StyleClass="showcase-layout-child-probe"
                                        Text="Visible item A" />
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-hidden-child-collapse-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        IsVisible="False"
                                        Text="Hidden item B" />
                                    <Label
                                        AutomationId="layout-lab-child-vertical-stack-hidden-child-collapse-third"
                                    StyleClass="showcase-layout-child-probe"
                                        Text="Visible item C" />
                                </VerticalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="layout-lab-group-horizontal-stack"
                Spacing="8">
                <Label
                    AutomationId="layout-lab-group-horizontal-stack-title"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Text="Group C — HorizontalStackLayout parent scenarios" />
                <Grid
                    AutomationId="layout-lab-matrix-horizontal-stack"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto">
                    <ContentView
                        AutomationId="layout-lab-card-horizontal-stack-multi-child-spacing"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Multiple children + spacing" />
                            <Label Text="Parent: HorizontalStackLayout | Parent Size: 360x130 | Child: ContentView x3 | Child Config: Spacing=12" />
                            <Label
                                AutomationId="layout-lab-expected-horizontal-stack-multi-child-spacing"
                                Text="Expected: Children flow left-to-right with consistent horizontal spacing." />
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-multi-child-spacing"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="130"
                                WidthRequest="360">
                                <HorizontalStackLayout Spacing="12">
                                    <ContentView
                                        AutomationId="layout-lab-child-horizontal-stack-multi-child-spacing-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        HeightRequest="66"
                                        WidthRequest="96">
                                        <Label Text="Row A" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="66"
                                        WidthRequest="96">
                                        <Label Text="Row B" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="66"
                                        WidthRequest="96">
                                        <Label Text="Row C" />
                                    </ContentView>
                                </HorizontalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-horizontal-stack-constrained-width-overflow"
                        Grid.Column="1"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Constrained width overflow" />
                            <Label Text="Parent: HorizontalStackLayout | Parent Size: 280x130 | Child: ContentView x2 | Child Config: WidthRequest=220 each" />
                            <Label
                                AutomationId="layout-lab-expected-horizontal-stack-constrained-width-overflow"
                                Text="Expected: Both hosts keep requested child width under tight bounds; clipped host hides overflow while unclipped host exposes it." />
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-constrained-width-overflow"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="130"
                                WidthRequest="280">
                                <HorizontalStackLayout
                                    AutomationId="layout-lab-overflow-host-horizontal-unclipped"
                                    Spacing="8">
                                    <ContentView
                                        AutomationId="layout-lab-child-horizontal-stack-constrained-width-overflow-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        HeightRequest="66"
                                        WidthRequest="220">
                                        <Label Text="Overflow A" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="66"
                                        AutomationId="layout-lab-child-horizontal-stack-constrained-width-overflow-secondary"
                                    StyleClass="showcase-layout-child-probe"
                                        WidthRequest="220">
                                        <Label Text="Overflow B" />
                                    </ContentView>
                                </HorizontalStackLayout>
                            </ContentView>
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-constrained-width-overflow-clipped"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="130"
                                WidthRequest="280">
                                <HorizontalStackLayout
                                    AutomationId="layout-lab-overflow-host-horizontal-clipped"
                                    Spacing="8">
                                    <HorizontalStackLayout.Clip>
                                        <RectangleGeometry Rect="0,0,260,110" />
                                    </HorizontalStackLayout.Clip>
                                    <ContentView
                                        HeightRequest="66"
                                        WidthRequest="220">
                                        <Label Text="Clip A" />
                                    </ContentView>
                                    <ContentView
                                        AutomationId="layout-lab-child-horizontal-stack-constrained-width-overflow-clipped-secondary"
                                    StyleClass="showcase-layout-child-probe"
                                        HeightRequest="66"
                                        WidthRequest="220">
                                        <Label Text="Clip B" />
                                    </ContentView>
                                </HorizontalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-horizontal-stack-stretch-cross-axis"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.Row="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cross-axis stretch behavior" />
                            <Label Text="Parent: HorizontalStackLayout | Parent Size: 360x150 | Child: ContentView | Child Config: VerticalOptions=Fill" />
                            <Label
                                AutomationId="layout-lab-expected-horizontal-stack-stretch-cross-axis"
                                Text="Expected: Child probe fills available height in row-flow cross axis." />
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-stretch-cross-axis"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="150"
                                WidthRequest="360">
                                <HorizontalStackLayout Spacing="8">
                                    <ContentView
                                        AutomationId="layout-lab-child-horizontal-stack-stretch-cross-axis-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        VerticalOptions="Fill"
                                        WidthRequest="98">
                                        <Label Text="Stretch height" />
                                    </ContentView>
                                    <ContentView
                                        HeightRequest="66"
                                        WidthRequest="98">
                                        <Label Text="Fixed peer" />
                                    </ContentView>
                                </HorizontalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-horizontal-stack-centered-child"
                        Grid.Column="1"
                        StyleClass="showcase-layout-card"
                        Grid.Row="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Centered child alignment" />
                            <Label Text="Parent: HorizontalStackLayout | Parent Size: 360x150 | Child: ContentView | Child Config: VerticalOptions=Center" />
                            <Label
                                AutomationId="layout-lab-expected-horizontal-stack-centered-child"
                                Text="Expected: Child remains vertically centered inside row host." />
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-centered-child"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="150"
                                WidthRequest="360">
                                <HorizontalStackLayout Spacing="8">
                                    <ContentView
                                        HeightRequest="96"
                                        WidthRequest="104">
                                        <Label Text="Tall peer" />
                                    </ContentView>
                                    <ContentView
                                        AutomationId="layout-lab-child-horizontal-stack-centered-child-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        WidthRequest="124">
                                        <Label Text="Centered probe" />
                                    </ContentView>
                                </HorizontalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-horizontal-stack-hidden-child-collapse"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.ColumnSpan="2"
                        Grid.Row="2">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Hidden child collapse participation" />
                            <Label Text="Parent: HorizontalStackLayout | Parent Size: 360x130 | Child: Label x3 | Child Config: middle IsVisible=false" />
                            <Label
                                AutomationId="layout-lab-expected-horizontal-stack-hidden-child-collapse"
                                Text="Expected: Hidden middle child is removed from row flow and spacing updates accordingly." />
                            <ContentView
                                AutomationId="layout-lab-parent-horizontal-stack-hidden-child-collapse"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="130"
                                WidthRequest="360">
                                <HorizontalStackLayout Spacing="14">
                                    <Label Text="Visible A" />
                                    <Label
                                        AutomationId="layout-lab-child-horizontal-stack-hidden-child-collapse-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        IsVisible="False"
                                        Text="Hidden B" />
                                    <Label Text="Visible C" />
                                </HorizontalStackLayout>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="layout-lab-group-grid"
                Spacing="8">
                <Label
                    AutomationId="layout-lab-group-grid-title"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Text="Group D — Grid parent scenarios" />
                <Grid
                    AutomationId="layout-lab-matrix-grid"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto">
                    <ContentView
                        AutomationId="layout-lab-card-grid-single-cell-fixed"
                        Grid.Column="0"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Single-cell fixed grid" />
                            <Label Text="Parent: Grid(1x1) | Parent Size: 320x170 | Child: Button | Child Config: Centered in cell" />
                            <Label
                                AutomationId="layout-lab-expected-grid-single-cell-fixed"
                                Text="Expected: Child is constrained by the single fixed cell and remains centered." />
                            <ContentView
                                AutomationId="layout-lab-parent-grid-single-cell-fixed"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="170"
                                WidthRequest="320">
                                <Grid ColumnDefinitions="*" RowDefinitions="*">
                                    <Button
                                        AutomationId="layout-lab-child-grid-single-cell-fixed-primary"
                                    StyleClass="showcase-layout-child-probe"
                                        HorizontalOptions="Center"
                                        Text="Single-cell"
                                        VerticalOptions="Center" />
                                </Grid>
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <ContentView
                        AutomationId="layout-lab-card-grid-placement-rows-columns"
                        Grid.Column="1"
                        StyleClass="showcase-layout-card"
                        Grid.Row="0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Row/column placement" />
                            <Label Text="Parent: Grid(2x2) | Parent Size: 320x170 | Child: Label probes | Child Config: explicit row/column coordinates" />
                            <Label
                                AutomationId="layout-lab-expected-grid-placement-rows-columns"
                                Text="Expected: Probes land in configured grid coordinates and preserve row/column ordering." />
                            <ContentView
                                AutomationId="layout-lab-parent-grid-placement-rows-columns"
                                StyleClass="showcase-layout-parent-surface"
                                HeightRequest="170"
                                WidthRequest="320">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                                    <Label
                                        AutomationId="layout-lab-child-grid-placement-rows-columns-primary"
                                    StyleClass="showcase-layout-child-probe"
