<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Showcase.Shared.App.ShowcaseStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="ShowcaseInkColor">#0F172A</Color>
    <Color x:Key="ShowcaseMutedColor">#334155</Color>
    <Color x:Key="ShowcaseStrongColor">#0B7285</Color>
    <Color x:Key="ShowcaseStrongAccentColor">#0B9488</Color>
    <Color x:Key="ShowcaseCardBackgroundColor">#E6FFFFFF</Color>
    <Color x:Key="ShowcaseSurfaceBackgroundColor">#C7F8FAFC</Color>
    <Color x:Key="ShowcaseActionBackgroundColor">#CCFBF1</Color>
    <Color x:Key="ShowcaseActionBorderColor">#730B7285</Color>
    <Color x:Key="ShowcaseEntryBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ShowcaseBacklogLineColor">#260F172A</Color>
    <Color x:Key="ShowcaseBacklogHeaderBackgroundColor">#F1F5F9</Color>
    <Color x:Key="ShowcaseBacklogCellBackgroundColor">#F8FAFC</Color>

    <Style x:Key="ShowcaseRootPageStyle" TargetType="ContentPage">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <GradientStop Color="#F8FAFC" Offset="0.0" />
                    <GradientStop Color="#E2E8F0" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShowcasePageRootStackStyle" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="28,24,28,56" />
        <Setter Property="Spacing" Value="20" />
    </Style>

    <Style x:Key="ShowcaseTopNavStyle" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Padding" Value="10,10,10,10" />
        <Setter Property="BackgroundColor" Value="#CCF8FAFC" />
    </Style>

    <Style x:Key="ShowcaseSectionCardStyle" TargetType="VerticalStackLayout">
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseCardBackgroundColor}" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="ShowcaseSectionCardContentStyle" TargetType="ContentView">
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseCardBackgroundColor}" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="ShowcaseBacklogHostScrollStyle" TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseCardBackgroundColor}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Always" />
        <Setter Property="VerticalScrollBarVisibility" Value="Never" />
    </Style>

    <Style x:Key="ShowcaseBacklogTableStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="RowSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseBacklogLineColor}" />
        <Setter Property="MinimumWidthRequest" Value="980" />
    </Style>

    <Style x:Key="ShowcaseBacklogHeaderCellStyle" TargetType="ContentView">
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseBacklogHeaderBackgroundColor}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="ShowcaseBacklogDataCellStyle" TargetType="ContentView">
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseBacklogCellBackgroundColor}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="ShowcaseFeatureCardStyle" TargetType="VerticalStackLayout">
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseSurfaceBackgroundColor}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="ShowcaseLayoutLabGroupCardStyle" TargetType="VerticalStackLayout">
        <Setter Property="BackgroundColor" Value="#D9F1F5F9" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="ShowcaseLayoutLabMatrixStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="RowSpacing" Value="12" />
    </Style>

    <Style x:Key="ShowcaseLayoutLabScenarioCardStyle" TargetType="ContentView">
        <Setter Property="BackgroundColor" Value="#EFF6FF" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="ShowcaseLayoutLabParentSurfaceStyle" TargetType="ContentView">
        <Setter Property="BackgroundColor" Value="#CFD9F7" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="ShowcaseLayoutLabProbeSurfaceStyle" TargetType="ContentView">
        <Setter Property="BackgroundColor" Value="#BFDBFE" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="IBM Plex Sans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
    </Style>

    <Style x:Key="ShowcaseLayoutLabConfigLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="IBM Plex Mono" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="#1F2937" />
    </Style>

    <Style x:Key="ShowcaseLayoutLabExpectedLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#0B7285" />
    </Style>

    <Style x:Key="ShowcaseNavBrandLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="ShowcaseNavDividerLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="ShowcaseMutedSmallLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ShowcaseMutedColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.82" />
    </Style>

    <Style x:Key="ShowcaseKickerLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseStrongColor}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="ShowcaseHeadlineLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
    </Style>

    <Style x:Key="ShowcaseBodyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseMutedColor}" />
    </Style>

    <Style x:Key="ShowcaseBacklogHeaderLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
    </Style>

    <Style x:Key="ShowcaseBacklogDataLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="#102A43" />
    </Style>

    <Style x:Key="ShowcaseSectionTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
    </Style>

    <Style x:Key="ShowcaseSubsectionTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
    </Style>

    <Style x:Key="ShowcaseTaglineLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Space Grotesk" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseStrongColor}" />
    </Style>

    <Style x:Key="ShowcasePipelineLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="IBM Plex Mono" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
        <Setter Property="BackgroundColor" Value="#CCECFDF5" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="ShowcaseBulletLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="#102A43" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="IBM Plex Sans" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseActionBackgroundColor}" />
        <Setter Property="BorderColor" Value="{StaticResource ShowcaseActionBorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="42" />
    </Style>

    <Style x:Key="ShowcaseNavButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseStrongColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="ShowcaseLabActionButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#DBEAFE" />
        <Setter Property="BorderColor" Value="#6B7280" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="38" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="IBM Plex Sans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource ShowcaseInkColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ShowcaseEntryBackgroundColor}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style x:Key="ShowcaseScrollCueLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ShowcaseMutedColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="ShowcaseBacklogStatusChipButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="IBM Plex Sans" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="HeightRequest" Value="30" />
    </Style>

    <Style
        x:Key="ShowcaseBacklogStatusCompleteButtonStyle"
        BasedOn="{StaticResource ShowcaseBacklogStatusChipButtonStyle}"
        TargetType="Button">
        <Setter Property="TextColor" Value="#166534" />
        <Setter Property="BackgroundColor" Value="#D9DCFCE7" />
        <Setter Property="BorderColor" Value="#73226043" />
    </Style>

    <Style
        x:Key="ShowcaseBacklogStatusStartedButtonStyle"
        BasedOn="{StaticResource ShowcaseBacklogStatusChipButtonStyle}"
        TargetType="Button">
        <Setter Property="TextColor" Value="#0F766E" />
        <Setter Property="BackgroundColor" Value="#D9CCFBF1" />
        <Setter Property="BorderColor" Value="#730F766E" />
    </Style>

    <Style
        x:Key="ShowcaseBacklogStatusNotStartedButtonStyle"
        BasedOn="{StaticResource ShowcaseBacklogStatusChipButtonStyle}"
        TargetType="Button">
        <Setter Property="TextColor" Value="#7C2D12" />
        <Setter Property="BackgroundColor" Value="#D9FED7AA" />
        <Setter Property="BorderColor" Value="#737C2D12" />
    </Style>

</ResourceDictionary>
