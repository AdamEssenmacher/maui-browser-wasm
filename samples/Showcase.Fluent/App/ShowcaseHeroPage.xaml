<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Showcase.Fluent.App.ShowcaseHeroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Showcase.Fluent.App"
    AutomationId="showcase-root">

    <Grid
        AutomationId="showcase-page-grid"
        ColumnDefinitions="*,Auto,*"
        RowDefinitions="Auto">
        <VerticalStackLayout
            Grid.Column="1"
            AutomationId="hero-page-stack"
            HorizontalOptions="Center"
            MaximumWidthRequest="1040"
            Style="{StaticResource ShowcasePageRootStackStyle}">

        <HorizontalStackLayout
            AutomationId="showcase-top-nav"
            Style="{StaticResource ShowcaseTopNavStyle}">
            <Label
                AutomationId="showcase-nav-brand"
                Style="{StaticResource ShowcaseNavBrandLabelStyle}"
                Text="Mirage" />
            <Label Style="{StaticResource ShowcaseNavDividerLabelStyle}" Text="|" />
            <Button
                AutomationId="showcase-nav-demo"
                Clicked="OnDemoNavClicked"
                Style="{StaticResource ShowcaseNavButtonStyle}"
                Text="Demo" />
            <Label Style="{StaticResource ShowcaseNavDividerLabelStyle}" Text="|" />
            <Button
                AutomationId="showcase-nav-architecture"
                Clicked="OnArchitectureNavClicked"
                Style="{StaticResource ShowcaseNavButtonStyle}"
                Text="Architecture" />
            <Label Style="{StaticResource ShowcaseNavDividerLabelStyle}" Text="|" />
            <Button
                AutomationId="showcase-nav-providers"
                Clicked="OnProvidersNavClicked"
                Style="{StaticResource ShowcaseNavButtonStyle}"
                Text="Providers" />
            <Label Style="{StaticResource ShowcaseNavDividerLabelStyle}" Text="|" />
            <Button
                AutomationId="showcase-nav-content-view"
                Clicked="OnOpenContentViewDemoClicked"
                Style="{StaticResource ShowcaseNavButtonStyle}"
                Text="ContentView" />
            <Label Style="{StaticResource ShowcaseNavDividerLabelStyle}" Text="|" />
            <Label
                AutomationId="showcase-nav-docs-placeholder"
                Style="{StaticResource ShowcaseMutedSmallLabelStyle}"
                Text="Docs" />
            <Label Style="{StaticResource ShowcaseNavDividerLabelStyle}" Text="|" />
            <Label
                AutomationId="showcase-nav-github-placeholder"
                Style="{StaticResource ShowcaseMutedSmallLabelStyle}"
                Text="GitHub" />
        </HorizontalStackLayout>

        <VerticalStackLayout
            AutomationId="hero"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="10">
            <Label
                AutomationId="hero-kicker"
                Style="{StaticResource ShowcaseKickerLabelStyle}"
                Text="Mirage" />
            <Label
                AutomationId="hero-headline"
                Style="{StaticResource ShowcaseHeadlineLabelStyle}"
                Text="Run .NET MAUI apps in the browser — with real DOM UI." />
            <Label
                AutomationId="hero-subheadline"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Mirage is a semantic runtime that brings .NET MAUI to the browser by rendering your UI as actual DOM elements and Web Components using pluggable component providers." />
            <Label
                AutomationId="hero-description"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Build your UI once with MAUI and run it directly in the browser without rewriting your UI layer." />
            <Label
                AutomationId="hero-tagline-primary"
                Style="{StaticResource ShowcaseTaglineLabelStyle}"
                Text="MAUI UI, rendered as real web UI." />
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="architecture"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <Label
                AutomationId="architecture-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Architecture Snapshot" />
            <Label
                AutomationId="architecture-pipeline"
                Style="{StaticResource ShowcasePipelineLabelStyle}"
                Text="MAUI&#10;  ↓&#10;Mirage semantic runtime&#10;  ↓&#10;Component provider (Fluent, UI5, custom, ...)&#10;  ↓&#10;DOM + Web Components" />
            <Label
                AutomationId="architecture-body"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Mirage preserves the MAUI programming model while producing real web UI that works naturally with the browser platform." />
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="hero-why-matters"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="6">
            <Label
                AutomationId="hero-why-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Why This Matters" />
            <Label
                AutomationId="hero-why-body"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Mirage apps behave like real web applications because they are." />
            <Label
                AutomationId="hero-why-bullet-devtools"
                Style="{StaticResource ShowcaseBulletLabelStyle}"
                Text="• Inspect the UI in browser DevTools" />
            <Label
                AutomationId="hero-why-bullet-css"
                Style="{StaticResource ShowcaseBulletLabelStyle}"
                Text="• Style components with CSS" />
            <Label
                AutomationId="hero-why-bullet-components"
                Style="{StaticResource ShowcaseBulletLabelStyle}"
                Text="• Use Web Components" />
            <Label
                AutomationId="hero-why-bullet-platform"
                Style="{StaticResource ShowcaseBulletLabelStyle}"
                Text="• Integrate naturally with the web platform" />
            <Label
                AutomationId="hero-why-contrast"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Unlike canvas-based cross-platform renderers, Mirage produces inspectable DOM structure instead of drawing pixels to a graphics surface." />
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="hero-cta"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <HorizontalStackLayout
                AutomationId="hero-cta-row"
                Spacing="10">
                <Button
                    AutomationId="hero-cta-demo"
                    Clicked="OnDemoCtaClicked"
                    Text="Try the Live Demo" />
                <Button
                    AutomationId="hero-cta-architecture"
                    Clicked="OnArchitectureCtaClicked"
                    Text="Explore the Architecture" />
            </HorizontalStackLayout>
            <Label
                AutomationId="hero-cta-github-placeholder"
                Style="{StaticResource ShowcaseMutedSmallLabelStyle}"
                Text="View on GitHub" />
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="demo"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <Label
                AutomationId="demo-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Live Mirage Demo" />
            <Label
                AutomationId="showcase-demo-your-name-label"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Your name:" />
            <Entry
                AutomationId="showcase-demo-entry"
                Placeholder="Type your name"
                Text="{Binding Name, Mode=TwoWay}" />
            <Label
                AutomationId="showcase-demo-greeting"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="{Binding Greeting}" />
            <Button
                AutomationId="showcase-demo-button"
                Command="{Binding ClickCommand}"
                Text="Click Me" />
            <Label
                AutomationId="showcase-demo-count"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="{Binding ClickCountText}" />
            <Label
                AutomationId="showcase-demo-powered-by"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Powered by Mirage + Fluent UI Web Components" />
            <Label
                AutomationId="showcase-demo-devtools-hint"
                Style="{StaticResource ShowcaseTaglineLabelStyle}"
                Text="Open DevTools and inspect this page. The UI is rendered as real Fluent UI Web Components and DOM elements." />
            <Label
                AutomationId="showcase-generic-demo-title"
                Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                Text="Generic WebNode Demo" />
            <local:ShowcaseVendorWidget
                AutomationId="showcase-generic-widget"
                Clicked="OnGenericWidgetClicked"
                Text="{Binding GenericWidgetText}" />
            <Label
                AutomationId="showcase-generic-widget-count"
                Text="{Binding GenericWidgetClicksText}" />

            <VerticalStackLayout
                AutomationId="showcase-foundations-lab"
                Style="{StaticResource ShowcaseFeatureCardStyle}"
                Spacing="8">
                <Label
                    AutomationId="showcase-foundations-lab-title"
                    Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                    Text="Foundations Lab (Label + IView Core + VerticalStack)" />
                <Label
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="Label live update" />
                <Entry
                    AutomationId="foundations-label-input"
                    Placeholder="Type to update label"
                    Text="{Binding FoundationsLabelInput, Mode=TwoWay}" />
                <Label
                    AutomationId="foundations-label-output"
                    Text="{Binding FoundationsLabelOutput}" />

                <Button
                    AutomationId="foundations-visibility-toggle"
                    Command="{Binding ToggleFoundationsVisibilityCommand}"
                    Style="{StaticResource ShowcaseLabActionButtonStyle}"
                    Text="{Binding FoundationsVisibilityButtonText}" />
                <Label
                    AutomationId="foundations-visibility-target"
                    IsVisible="{Binding FoundationsVisibilityTargetVisible}"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="Visibility target: this label should hide and show." />

                <Button
                    AutomationId="foundations-margin-toggle"
                    Command="{Binding ToggleFoundationsMarginCommand}"
                    Style="{StaticResource ShowcaseLabActionButtonStyle}"
                    Text="{Binding FoundationsMarginButtonText}" />
                <Label
                    AutomationId="foundations-margin-target"
                    Margin="{Binding FoundationsMarginTargetMargin}"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="Margin target: toggle to verify deterministic margin formatting." />

                <Button
                    AutomationId="foundations-stack-spacing-toggle"
                    Command="{Binding ToggleFoundationsStackSpacingCommand}"
                    Style="{StaticResource ShowcaseLabActionButtonStyle}"
                    Text="{Binding FoundationsStackSpacingButtonText}" />
                <VerticalStackLayout
                    AutomationId="foundations-stack-probe"
                    Spacing="{Binding FoundationsStackSpacing}">
                    <Label
                        AutomationId="foundations-stack-probe-a"
                        Text="Stack probe A" />
                    <Label
                        AutomationId="foundations-stack-probe-b"
                        Text="Stack probe B" />
                    <Label
                        AutomationId="foundations-stack-probe-c"
                        Text="Stack probe C" />
                </VerticalStackLayout>

                <Button
                    AutomationId="foundations-horizontal-spacing-toggle"
                    Command="{Binding ToggleFoundationsHorizontalStackSpacingCommand}"
                    Style="{StaticResource ShowcaseLabActionButtonStyle}"
                    Text="{Binding FoundationsHorizontalStackSpacingButtonText}" />
                <HorizontalStackLayout
                    AutomationId="foundations-horizontal-stack-probe"
                    Spacing="{Binding FoundationsHorizontalStackSpacing}">
                    <Label
                        AutomationId="foundations-horizontal-probe-a"
                        Text="Horizontal A" />
                    <Label
                        AutomationId="foundations-horizontal-probe-b"
                        Text="Horizontal B" />
                    <Label
                        AutomationId="foundations-horizontal-probe-c"
                        Text="Horizontal C" />
                </HorizontalStackLayout>

                <Button
                    AutomationId="foundations-grid-spacing-toggle"
                    Command="{Binding ToggleFoundationsGridSpacingCommand}"
                    Style="{StaticResource ShowcaseLabActionButtonStyle}"
                    Text="{Binding FoundationsGridSpacingButtonText}" />
                <Grid
                    AutomationId="foundations-grid-probe"
                    ColumnDefinitions="Auto,*,2*"
                    ColumnSpacing="{Binding FoundationsGridColumnSpacing}"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{Binding FoundationsGridRowSpacing}">
                    <Label
                        AutomationId="foundations-grid-cell-r0c0"
                        Grid.Column="0"
                        Grid.Row="0"
                        Text="r0c0" />
                    <Label
                        AutomationId="foundations-grid-cell-r0c1"
                        Grid.Column="1"
                        Grid.Row="0"
                        Text="r0c1" />
                    <Label
                        AutomationId="foundations-grid-cell-r0c2"
                        Grid.Column="2"
                        Grid.Row="0"
                        Text="r0c2" />
                    <Label
                        AutomationId="foundations-grid-cell-span"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="1"
                        HorizontalOptions="Center"
                        Text="span center" />
                    <Label
                        AutomationId="foundations-grid-cell-r1c2"
                        Grid.Column="2"
                        Grid.Row="1"
                        HorizontalOptions="End"
                        Text="r1c2 end" />
                </Grid>

                <ContentView
                    AutomationId="foundations-bg-solid"
                    BackgroundColor="#DBEAFE"
                    HeightRequest="68"
                    Padding="10">
                    <Label Text="Solid background surface" />
                </ContentView>

                <ContentView
                    AutomationId="foundations-bg-linear"
                    HeightRequest="68"
                    Padding="10">
                    <ContentView.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="#BFDBFE" Offset="0.0" />
                            <GradientStop Color="#DDD6FE" Offset="1.0" />
                        </LinearGradientBrush>
                    </ContentView.Background>
                    <Label Text="Linear gradient background surface" />
                </ContentView>

                <ContentView
                    AutomationId="foundations-size-target"
                    BackgroundColor="#E2E8F0"
                    HeightRequest="52"
                    MaximumWidthRequest="260"
                    MinimumWidthRequest="160"
                    Padding="8"
                    WidthRequest="220">
                    <Label
                        AutomationId="foundations-opacity-target"
                        Opacity="0.58"
                        Text="Opacity + size request probe" />
                </ContentView>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <ContentView AutomationId="providers">
            <VerticalStackLayout
                AutomationId="providers-content"
                Style="{StaticResource ShowcaseSectionCardStyle}"
                Spacing="12">
                <Label
                    AutomationId="providers-title"
                    Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                    Text="Feature Highlights" />

                <VerticalStackLayout
                    AutomationId="showcase-feature-dom"
                    Style="{StaticResource ShowcaseFeatureCardStyle}"
                    Spacing="4">
                    <Label
                        AutomationId="showcase-feature-dom-title"
                        Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                        Text="Real DOM Rendering" />
                    <Label
                        AutomationId="showcase-feature-dom-body"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Mirage renders UI as real DOM elements and Web Components. Use standard browser tooling to inspect, debug, and style your app." />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="showcase-feature-maui"
                    Style="{StaticResource ShowcaseFeatureCardStyle}"
                    Spacing="4">
                    <Label
                        AutomationId="showcase-feature-maui-title"
                        Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                        Text="MAUI Programming Model" />
                    <Label
                        AutomationId="showcase-feature-maui-body"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Write UI with MAUI controls and layouts. Mirage translates them into semantic UI and renders them in the browser." />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="showcase-feature-providers"
                    Style="{StaticResource ShowcaseFeatureCardStyle}"
                    Spacing="4">
                    <Label
                        AutomationId="showcase-feature-providers-title"
                        Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                        Text="Pluggable Component Providers" />
                    <Label
                        AutomationId="showcase-feature-providers-body"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Mirage separates UI semantics from rendering. Fluent UI Web Components is the first polished reference provider (built on FAST foundations), and the architecture is designed for providers such as UI5 and custom design systems." />
                </VerticalStackLayout>

                <Label
                    AutomationId="showcase-tagline-secondary"
                    Style="{StaticResource ShowcaseTaglineLabelStyle}"
                    Text="MAUI UI, rendered as real web UI." />
            </VerticalStackLayout>
        </ContentView>

        <VerticalStackLayout
            AutomationId="showcase-backlog"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <Label
                AutomationId="showcase-backlog-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Control / Handler Backlog" />
            <Label
                AutomationId="showcase-backlog-subtitle"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Current Mirage implementation status across MAUI controls/layouts and shared abstractions." />
            <ContentView
                x:Name="BacklogTableHost"
                AutomationId="showcase-backlog-table-host" />
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="showcase-control-demos"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="8">
            <Label
                AutomationId="showcase-control-demos-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="Control Demo Pages" />
            <Label
                AutomationId="showcase-control-demos-subtitle"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="Dedicated pages validate control/handler correctness in depth. Start with ContentView." />
            <Button
                AutomationId="showcase-open-content-view-demo"
                Clicked="OnOpenContentViewDemoClicked"
                Text="Jump to ContentView Demo" />
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="content-view-demo-page"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="10">
            <Label
                AutomationId="content-view-demo-kicker"
                Style="{StaticResource ShowcaseKickerLabelStyle}"
                Text="Control Demo Surface" />
            <Label
                AutomationId="content-view-demo-title"
                Style="{StaticResource ShowcaseSectionTitleLabelStyle}"
                Text="ContentView" />
            <Label
                AutomationId="content-view-demo-description"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="This dedicated ContentView demo verifies core IView projection into real DOM output: background, opacity, visibility, margin/padding, and layout positioning." />

            <VerticalStackLayout
                AutomationId="content-view-visual-lab"
                Style="{StaticResource ShowcaseFeatureCardStyle}"
                Spacing="10">
                <Label
                    AutomationId="content-view-visual-lab-title"
                    Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                    Text="IView Visual Core" />
                <Label
                    AutomationId="content-view-visual-lab-body"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="Mutate visual properties through MAUI bindings and inspect the resulting DOM styles." />

                <HorizontalStackLayout
                    AutomationId="content-view-visual-actions-row-a"
                    Spacing="8">
                    <Button
                        AutomationId="content-view-background-toggle"
                        Command="{Binding ToggleContentViewBackgroundCommand}"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="{Binding ContentViewBackgroundButtonText}" />
                    <Button
                        AutomationId="content-view-opacity-toggle"
                        Command="{Binding ToggleContentViewOpacityCommand}"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="{Binding ContentViewOpacityButtonText}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout
                    AutomationId="content-view-visual-actions-row-b"
                    Spacing="8">
                    <Button
                        AutomationId="content-view-visibility-toggle"
                        Command="{Binding ToggleContentViewVisibilityCommand}"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="{Binding ContentViewVisibilityButtonText}" />
                    <Button
                        AutomationId="content-view-margin-toggle"
                        Command="{Binding ToggleContentViewMarginCommand}"
                        Style="{StaticResource ShowcaseLabActionButtonStyle}"
                        Text="{Binding ContentViewMarginButtonText}" />
                </HorizontalStackLayout>

                <Label
                    AutomationId="content-view-visual-state"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="{Binding ContentViewDiagnosticsText}" />

                <ContentView
                    AutomationId="content-view-visual-target"
                    Background="{Binding ContentViewBackground}"
                    IsVisible="{Binding ContentViewVisible}"
                    Margin="{Binding ContentViewMargin}"
                    Opacity="{Binding ContentViewOpacity}"
                    Padding="{Binding ContentViewPadding}"
                    Style="{StaticResource ShowcaseContentViewVisualTargetStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            AutomationId="content-view-visual-target-title"
                            Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                            Text="Visual Probe Surface" />
                        <Label
                            AutomationId="content-view-visual-target-body"
                            Style="{StaticResource ShowcaseBodyLabelStyle}"
                            Text="This ContentView updates background, opacity, margin, padding, and visibility through MAUI property mapping." />
                    </VerticalStackLayout>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="content-view-positioning-lab"
                Style="{StaticResource ShowcaseFeatureCardStyle}"
                Spacing="10">
                <Label
                    AutomationId="content-view-positioning-lab-title"
                    Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                    Text="Positioning: HorizontalOptions + VerticalOptions" />
                <Label
                    AutomationId="content-view-positioning-lab-body"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="The target ContentView is positioned inside fixed hosts. Compare Start/Center/End behavior for HorizontalOptions and VerticalOptions." />

                <Label
                    AutomationId="content-view-positioning-summary"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="Static probes below show Start/Center/End positioning for HorizontalOptions and VerticalOptions." />

                <ContentView
                    AutomationId="content-view-positioning-host"
                    Style="{StaticResource ShowcaseContentViewPositioningHostStyle}">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout
                            AutomationId="content-view-horizontal-positioning-host"
                            BackgroundColor="#CFD9F7"
                            HeightRequest="150"
                            Padding="10"
                            Spacing="4">
                            <ContentView
                                AutomationId="content-view-horizontal-position-start"
                                HeightRequest="72"
                                HorizontalOptions="Start"
                                MaximumHeightRequest="72"
                                MaximumWidthRequest="220"
                                MinimumHeightRequest="72"
                                MinimumWidthRequest="220"
                                Style="{StaticResource ShowcaseContentViewPositioningTargetStyle}"
                                WidthRequest="220">
                                <Label
                                    AutomationId="content-view-horizontal-position-start-body"
                                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                                    Text="HorizontalOptions.Start" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-horizontal-position-center"
                                HeightRequest="72"
                                HorizontalOptions="Center"
                                MaximumHeightRequest="72"
                                MaximumWidthRequest="220"
                                MinimumHeightRequest="72"
                                MinimumWidthRequest="220"
                                Style="{StaticResource ShowcaseContentViewPositioningTargetStyle}"
                                WidthRequest="220">
                                <Label
                                    AutomationId="content-view-horizontal-position-center-body"
                                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                                    Text="HorizontalOptions.Center" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-horizontal-position-end"
                                HeightRequest="72"
                                HorizontalOptions="End"
                                MaximumHeightRequest="72"
                                MaximumWidthRequest="220"
                                MinimumHeightRequest="72"
                                MinimumWidthRequest="220"
                                Style="{StaticResource ShowcaseContentViewPositioningTargetStyle}"
                                WidthRequest="220">
                                <Label
                                    AutomationId="content-view-horizontal-position-end-body"
                                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                                    Text="HorizontalOptions.End" />
                            </ContentView>
                        </VerticalStackLayout>

                        <HorizontalStackLayout
                            AutomationId="content-view-vertical-positioning-host"
                            BackgroundColor="#CFD9F7"
                            HeightRequest="150"
                            Padding="10"
                            Spacing="8">
                            <ContentView
                                AutomationId="content-view-vertical-position-start"
                                HeightRequest="72"
                                MaximumHeightRequest="72"
                                MaximumWidthRequest="220"
                                MinimumHeightRequest="72"
                                MinimumWidthRequest="220"
                                VerticalOptions="Start"
                                WidthRequest="220"
                                Style="{StaticResource ShowcaseContentViewPositioningTargetStyle}">
                                <Label
                                    AutomationId="content-view-vertical-position-start-body"
                                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                                    Text="VerticalOptions.Start" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-vertical-position-center"
                                HeightRequest="72"
                                MaximumHeightRequest="72"
                                MaximumWidthRequest="220"
                                MinimumHeightRequest="72"
                                MinimumWidthRequest="220"
                                VerticalOptions="Center"
                                WidthRequest="220"
                                Style="{StaticResource ShowcaseContentViewPositioningTargetStyle}">
                                <Label
                                    AutomationId="content-view-vertical-position-center-body"
                                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                                    Text="VerticalOptions.Center" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-vertical-position-end"
                                HeightRequest="72"
                                MaximumHeightRequest="72"
                                MaximumWidthRequest="220"
                                MinimumHeightRequest="72"
                                MinimumWidthRequest="220"
                                VerticalOptions="End"
                                WidthRequest="220"
                                Style="{StaticResource ShowcaseContentViewPositioningTargetStyle}">
                                <Label
                                    AutomationId="content-view-vertical-position-end-body"
                                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                                    Text="VerticalOptions.End" />
                            </ContentView>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ContentView>
            </VerticalStackLayout>

            <VerticalStackLayout
                AutomationId="content-view-size-overflow-lab"
                Style="{StaticResource ShowcaseFeatureCardStyle}"
                Spacing="10">
                <Label
                    AutomationId="content-view-size-overflow-lab-title"
                    Style="{StaticResource ShowcaseSubsectionTitleLabelStyle}"
                    Text="Size Request + Overflow Lab" />
                <Label
                    AutomationId="content-view-size-overflow-lab-body"
                    Style="{StaticResource ShowcaseBodyLabelStyle}"
                    Text="These probes verify WidthRequest/HeightRequest behavior with alignment and overflow under clipped and unclipped hosts." />

                <VerticalStackLayout
                    AutomationId="content-view-size-overflow-static-matrix"
                    Spacing="8">
                    <Label
                        AutomationId="content-view-size-width-baseline-title"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="1) WidthRequest + HorizontalOptions (fit baseline)" />
                    <ContentView
                        AutomationId="content-view-size-width-baseline-host"
                        HeightRequest="150"
                        Style="{StaticResource ShowcaseContentViewSizeHostStyle}">
                        <VerticalStackLayout Spacing="4">
                            <ContentView
                                AutomationId="content-view-size-width-fit-start"
                                HeightRequest="72"
                                HorizontalOptions="Start"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                WidthRequest="220">
                                <Label Text="Width fit + Horizontal Start" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-size-width-fit-center"
                                HeightRequest="72"
                                HorizontalOptions="Center"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                WidthRequest="220">
                                <Label Text="Width fit + Horizontal Center" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-size-width-fit-end"
                                HeightRequest="72"
                                HorizontalOptions="End"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                WidthRequest="220">
                                <Label Text="Width fit + Horizontal End" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <Label
                        AutomationId="content-view-size-width-overflow-unclipped-title"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="2) Width overflow, unclipped host" />
                    <VerticalStackLayout
                        AutomationId="content-view-size-width-overflow-unclipped-host"
                        BackgroundColor="#CFD9F7"
                        HeightRequest="96"
                        Padding="10"
                        Spacing="0"
                        WidthRequest="240">
                        <ContentView
                            AutomationId="content-view-size-width-overflow-unclipped-probe"
                            HeightRequest="72"
                            HorizontalOptions="Center"
                            Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                            WidthRequest="360">
                            <Label Text="Width overflow probe (unclipped host)" />
                        </ContentView>
                    </VerticalStackLayout>

                    <Label
                        AutomationId="content-view-size-width-overflow-clipped-title"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="3) Width overflow, clipped host" />
                    <VerticalStackLayout
                        AutomationId="content-view-size-width-overflow-clipped-host"
                        BackgroundColor="#CFD9F7"
                        HeightRequest="96"
                        Padding="10"
                        Spacing="0"
                        WidthRequest="240">
                        <VerticalStackLayout.Clip>
                            <RectangleGeometry Rect="0,0,240,96" />
                        </VerticalStackLayout.Clip>
                        <ContentView
                            AutomationId="content-view-size-width-overflow-clipped-probe"
                            HeightRequest="72"
                            HorizontalOptions="Center"
                            Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                            WidthRequest="360">
                            <Label Text="Width overflow probe (clipped host)" />
                        </ContentView>
                    </VerticalStackLayout>

                    <Label
                        AutomationId="content-view-size-height-baseline-title"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="4) HeightRequest + VerticalOptions (fit baseline)" />
                    <ContentView
                        AutomationId="content-view-size-height-baseline-host"
                        HeightRequest="150"
                        Style="{StaticResource ShowcaseContentViewSizeHostStyle}">
                        <HorizontalStackLayout HeightRequest="130" Spacing="8">
                            <ContentView
                                AutomationId="content-view-size-height-fit-start"
                                HeightRequest="72"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                VerticalOptions="Start"
                                WidthRequest="220">
                                <Label Text="Height fit + Vertical Start" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-size-height-fit-center"
                                HeightRequest="72"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                VerticalOptions="Center"
                                WidthRequest="220">
                                <Label Text="Height fit + Vertical Center" />
                            </ContentView>
                            <ContentView
                                AutomationId="content-view-size-height-fit-end"
                                HeightRequest="72"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                VerticalOptions="End"
                                WidthRequest="220">
                                <Label Text="Height fit + Vertical End" />
                            </ContentView>
                        </HorizontalStackLayout>
                    </ContentView>

                    <Label
                        AutomationId="content-view-size-height-overflow-unclipped-title"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="5) Height overflow, unclipped host" />
                    <HorizontalStackLayout
                        AutomationId="content-view-size-height-overflow-unclipped-host"
                        BackgroundColor="#CFD9F7"
                        HeightRequest="100"
                        Padding="10"
                        Spacing="6"
                        WidthRequest="240">
                        <ContentView
                            AutomationId="content-view-size-height-overflow-unclipped-probe"
                            HeightRequest="176"
                            Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                            VerticalOptions="Center"
                            WidthRequest="200">
                            <Label Text="Height overflow probe (unclipped host)" />
                        </ContentView>
                    </HorizontalStackLayout>

                    <Label
                        AutomationId="content-view-size-height-overflow-clipped-title"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="6) Height overflow, clipped host" />
                    <HorizontalStackLayout
                        AutomationId="content-view-size-height-overflow-clipped-host"
                        BackgroundColor="#CFD9F7"
                        HeightRequest="100"
                        Padding="10"
                        Spacing="6"
                        WidthRequest="240">
                        <HorizontalStackLayout.Clip>
                            <RectangleGeometry Rect="0,0,240,100" />
                        </HorizontalStackLayout.Clip>
                        <ContentView
                            AutomationId="content-view-size-height-overflow-clipped-probe"
                            HeightRequest="176"
                            Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                            VerticalOptions="Center"
                            WidthRequest="200">
                            <Label Text="Height overflow probe (clipped host)" />
                        </ContentView>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="content-view-size-overflow-interactive-row"
                    Spacing="8">
                    <Label
                        AutomationId="content-view-size-overflow-interactive-title"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="Interactive probe: toggle fit/overflow, alignment, and clip on/off." />

                    <HorizontalStackLayout
                        AutomationId="content-view-size-interactive-width-actions"
                        Spacing="8">
                        <Button
                            AutomationId="content-view-size-interactive-width-mode-toggle"
                            Command="{Binding ToggleContentViewWidthModeCommand}"
                            Style="{StaticResource ShowcaseLabActionButtonStyle}"
                            Text="{Binding ContentViewWidthModeButtonText}" />
                        <Button
                            AutomationId="content-view-size-interactive-horizontal-option-toggle"
                            Command="{Binding CycleContentViewHorizontalOptionCommand}"
                            Style="{StaticResource ShowcaseLabActionButtonStyle}"
                            Text="{Binding ContentViewHorizontalOptionButtonText}" />
                        <Button
                            AutomationId="content-view-size-interactive-width-clip-toggle"
                            Command="{Binding ToggleContentViewWidthClipCommand}"
                            Style="{StaticResource ShowcaseLabActionButtonStyle}"
                            Text="{Binding ContentViewWidthClipButtonText}" />
                    </HorizontalStackLayout>

                    <ContentView
                        AutomationId="content-view-size-interactive-width-host"
                        HeightRequest="96"
                        Style="{StaticResource ShowcaseContentViewSizeHostStyle}"
                        WidthRequest="240">
                        <VerticalStackLayout>
                            <ContentView
                                AutomationId="content-view-size-interactive-width-probe"
                                Clip="{Binding ContentViewInteractiveWidthClip}"
                                HeightRequest="72"
                                HorizontalOptions="{Binding ContentViewInteractiveHorizontalOptions}"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                WidthRequest="{Binding ContentViewInteractiveWidthRequest}">
                                <Label Text="Interactive width probe" />
                            </ContentView>
                        </VerticalStackLayout>
                    </ContentView>

                    <HorizontalStackLayout
                        AutomationId="content-view-size-interactive-height-actions"
                        Spacing="8">
                        <Button
                            AutomationId="content-view-size-interactive-height-mode-toggle"
                            Command="{Binding ToggleContentViewHeightModeCommand}"
                            Style="{StaticResource ShowcaseLabActionButtonStyle}"
                            Text="{Binding ContentViewHeightModeButtonText}" />
                        <Button
                            AutomationId="content-view-size-interactive-vertical-option-toggle"
                            Command="{Binding CycleContentViewVerticalOptionCommand}"
                            Style="{StaticResource ShowcaseLabActionButtonStyle}"
                            Text="{Binding ContentViewVerticalOptionButtonText}" />
                        <Button
                            AutomationId="content-view-size-interactive-height-clip-toggle"
                            Command="{Binding ToggleContentViewHeightClipCommand}"
                            Style="{StaticResource ShowcaseLabActionButtonStyle}"
                            Text="{Binding ContentViewHeightClipButtonText}" />
                    </HorizontalStackLayout>

                    <ContentView
                        AutomationId="content-view-size-interactive-height-host"
                        HeightRequest="100"
                        Style="{StaticResource ShowcaseContentViewSizeHostStyle}"
                        WidthRequest="240">
                        <HorizontalStackLayout HeightRequest="80" Spacing="6">
                            <ContentView
                                AutomationId="content-view-size-interactive-height-probe"
                                Clip="{Binding ContentViewInteractiveHeightClip}"
                                HeightRequest="{Binding ContentViewInteractiveHeightRequest}"
                                Style="{StaticResource ShowcaseContentViewSizeProbeStyle}"
                                VerticalOptions="{Binding ContentViewInteractiveVerticalOptions}"
                                WidthRequest="200">
                                <Label Text="Interactive height probe" />
                            </ContentView>
                        </HorizontalStackLayout>
                    </ContentView>

                    <Label
                        AutomationId="content-view-size-overflow-diagnostics"
                        Style="{StaticResource ShowcaseBodyLabelStyle}"
                        Text="{Binding ContentViewSizeOverflowDiagnosticsText}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label
                AutomationId="content-view-dom-proof"
                Style="{StaticResource ShowcaseTaglineLabelStyle}"
                Text="Open DevTools and inspect this section. The ContentView demo is rendered as real DOM and Fluent-backed elements." />
        </VerticalStackLayout>

        <VerticalStackLayout
            AutomationId="showcase-trust-signal"
            Style="{StaticResource ShowcaseSectionCardStyle}"
            Spacing="4">
            <Label
                AutomationId="showcase-runtime-badge"
                Style="{StaticResource ShowcaseTaglineLabelStyle}"
                Text="This page itself is running as a Mirage application using the Fluent provider." />
            <Label
                AutomationId="showcase-runtime-badge-detail"
                Style="{StaticResource ShowcaseBodyLabelStyle}"
                Text="The UI you see here is rendered by Mirage." />
        </VerticalStackLayout>

            <Label
                AutomationId="hero-scroll-cue"
                Margin="0,14,0,10"
                Style="{StaticResource ShowcaseScrollCueLabelStyle}"
                Text="↓ How Mirage Works" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
