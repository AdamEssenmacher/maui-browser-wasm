@page "/maui"
@page "/maui/{*StackPath}"
@using MauiBrowser.Runtime.Rendering
@using Microsoft.AspNetCore.Components
@using Microsoft.Maui
@using Microsoft.Maui.Controls
@using Microsoft.Maui.Graphics
@inject IMauiViewRenderer MauiViewRenderer
@inject NavigationManager NavigationManager

<h1>MAUI Runtime Demo</h1>

<p>
    This page renders real MAUI controls through the browser runtime pipeline, including styling bridge v0 via CSS variables.
</p>

<h2>Label (M1)</h2>
<div class="maui-surface">
    @MauiViewRenderer.Render(_label)
</div>

<h2>StackLayout (M2 Slice 1)</h2>
<div class="maui-surface">
    @MauiViewRenderer.Render(_stackLayout)
</div>

<h2>Grid (M2 Slice 2)</h2>
<div class="maui-surface">
    @MauiViewRenderer.Render(_grid)
</div>

<h2>CollectionView (M5 Slice 1 Prototype)</h2>
<div class="maui-surface">
    <p>
        Prototype behavior: renders <code>CollectionView</code> item templates through the runtime renderer pipeline (current v0 cap: 200 items).
    </p>
    @MauiViewRenderer.Render(_collectionView)
</div>

<h2>Button (M2 Slice 3 + M4 MudBlazor Plugin Override)</h2>
<div class="maui-surface">
    <p>
        Buttons on this page are rendered by the MudBlazor plugin override (`maui-mudblazor-button`, higher registry priority).
    </p>
    @MauiViewRenderer.Render(_button)
    <p>Clicked events: @_clickedCount | Command executions: @_commandCount</p>
</div>

<h2>Entry (M4 MudBlazor Plugin Override)</h2>
<div class="maui-surface">
    <p>
        This MAUI <code>Entry</code> is rendered through MudBlazor (`maui-mudblazor-entry`).
    </p>
    @MauiViewRenderer.Render(_entry)
    <p>Entry text: @_entry.Text | Text change events: @_entryTextChangeCount</p>
</div>

<h2>NavigationPage (M3)</h2>
<p>
    The M3 demo uses URL-synced MAUI navigation. Try deep links such as <code>/maui/details/settings/profile</code>.
</p>
<div class="maui-surface">
    @MauiViewRenderer.Render(_m3RenderRoot)
    <p>Requested route: <code>@CurrentRequestedPath</code></p>
    <p>Resolved stack route: <code>@CurrentResolvedRoute</code></p>
</div>

@code {
    private const int MaxStackDepth = 32;

    private static readonly HashSet<string> KnownPageKeys = new(StringComparer.Ordinal)
    {
        "details",
        "settings",
        "profile"
    };

    [Parameter]
    public string? StackPath { get; set; }

    private readonly Label _label = new()
    {
        Text = "Hello from MAUI Label rendered via Blazor DOM.",
        TextColor = Color.FromArgb("#0F172A"),
        BackgroundColor = Color.FromArgb("#FEF3C7"),
        FontSize = 20,
        Margin = new Thickness(0, 0, 0, 8)
    };

    private readonly StackLayout _stackLayout = new()
    {
        Orientation = StackOrientation.Vertical,
        Spacing = 8,
        BackgroundColor = Color.FromArgb("#EFF6FF"),
        Margin = new Thickness(0, 0, 0, 8),
        Children =
        {
            new Label { Text = "Stack item one" },
            new Label { Text = "Stack item two" },
            new Label { Text = "Stack item three" }
        }
    };

    private readonly Grid _grid = CreateGrid();
    private readonly CollectionView _collectionView = CreateCollectionView();
    private readonly Button _button = new()
    {
        Text = "Click MAUI Button",
        TextColor = Color.FromArgb("#FFFFFF"),
        BackgroundColor = Color.FromArgb("#1D4ED8"),
        BorderColor = Color.FromArgb("#1E40AF"),
        BorderWidth = 2,
        CornerRadius = 10,
        Padding = new Thickness(12, 8)
    };
    private readonly Entry _entry = new()
    {
        Text = "MudBlazor entry value",
        Placeholder = "Type a value"
    };

    private readonly List<string> _currentStackKeys = new();
    private NavigationPage _navigationPage = null!;
    private object _m3RenderRoot = null!;
    private int _clickedCount;
    private int _commandCount;
    private int _entryTextChangeCount;

    private string CurrentRequestedPath => NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

    private string CurrentResolvedRoute => BuildRoute(_currentStackKeys);

    protected override void OnInitialized()
    {
        _button.Command = new Command(OnButtonCommandExecuted);
        _button.CommandParameter = "maui-button";
        _button.Clicked += OnButtonClicked;
        _entry.TextChanged += OnEntryTextChanged;

        _navigationPage = new NavigationPage(CreateRootPage());
        _m3RenderRoot = _navigationPage;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!TryParseStackPath(StackPath, out var desiredStackKeys, out var routeError))
        {
            _m3RenderRoot = CreateNotFoundPage(routeError);
            return;
        }

        await SynchronizeNavigationStackAsync(desiredStackKeys);
        _m3RenderRoot = _navigationPage;
    }

    private static Grid CreateGrid()
    {
        var grid = new Grid
        {
            RowSpacing = 8,
            ColumnSpacing = 8,
            BackgroundColor = Color.FromArgb("#ECFDF5")
        };

        grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
        grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(2, GridUnitType.Star) });
        grid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
        grid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });

        var title = new Label { Text = "Grid title (spans two columns)" };
        Grid.SetRow(title, 0);
        Grid.SetColumn(title, 0);
        Grid.SetColumnSpan(title, 2);

        var left = new Label { Text = "Left cell" };
        Grid.SetRow(left, 1);
        Grid.SetColumn(left, 0);

        var right = new Label { Text = "Right cell" };
        Grid.SetRow(right, 1);
        Grid.SetColumn(right, 1);

        grid.Children.Add(title);
        grid.Children.Add(left);
        grid.Children.Add(right);

        return grid;
    }

    private static CollectionView CreateCollectionView()
    {
        return new CollectionView
        {
            SelectionMode = SelectionMode.None,
            ItemsSource = new[]
            {
                new CollectionItem(
                    "Renderer registry",
                    "Resolves the highest-priority renderer for each virtual view."),
                new CollectionItem(
                    "Template rendering",
                    "Each CollectionView item template is materialized and rendered via the registry."),
                new CollectionItem(
                    "DOM-first backend",
                    "Output is Blazor component render tree -> browser DOM."),
                new CollectionItem(
                    "Virtualization decision (M5)",
                    "Current prototype intentionally ships non-virtualized with an item cap.")
            },
            ItemTemplate = new DataTemplate(() =>
            {
                var title = new Label
                {
                    FontSize = 15,
                    TextColor = Color.FromArgb("#0F172A")
                };
                title.SetBinding(Label.TextProperty, nameof(CollectionItem.Title));

                var detail = new Label
                {
                    FontSize = 13,
                    TextColor = Color.FromArgb("#334155")
                };
                detail.SetBinding(Label.TextProperty, nameof(CollectionItem.Detail));

                return new StackLayout
                {
                    Spacing = 2,
                    Margin = new Thickness(0, 0, 0, 8),
                    Children =
                    {
                        title,
                        detail
                    }
                };
            })
        };
    }

    private static string BuildRoute(IReadOnlyList<string> stackKeys)
    {
        if (stackKeys.Count == 0)
        {
            return "/maui";
        }

        return "/maui/" + string.Join('/', stackKeys);
    }

    private static string GetPageTitle(string pageKey)
    {
        return pageKey switch
        {
            "details" => "Details",
            "settings" => "Settings",
            "profile" => "Profile",
            _ => "Unknown"
        };
    }

    private static bool TryParseStackPath(
        string? stackPath,
        out List<string> stackKeys,
        out string routeError)
    {
        stackKeys = new List<string>();
        routeError = string.Empty;

        if (string.IsNullOrWhiteSpace(stackPath))
        {
            return true;
        }

        var segments = stackPath.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (segments.Length > MaxStackDepth)
        {
            routeError = $"Route exceeds the maximum stack depth of {MaxStackDepth}.";
            return false;
        }

        foreach (var segment in segments)
        {
            var normalizedSegment = segment.ToLowerInvariant();
            if (!KnownPageKeys.Contains(normalizedSegment))
            {
                routeError = $"Unknown page key '{segment}'.";
                return false;
            }

            stackKeys.Add(normalizedSegment);
        }

        return true;
    }

    private async Task SynchronizeNavigationStackAsync(IReadOnlyList<string> desiredStackKeys)
    {
        var commonPrefixLength = 0;
        var sharedLength = Math.Min(_currentStackKeys.Count, desiredStackKeys.Count);
        while (commonPrefixLength < sharedLength
            && string.Equals(
                _currentStackKeys[commonPrefixLength],
                desiredStackKeys[commonPrefixLength],
                StringComparison.Ordinal))
        {
            commonPrefixLength++;
        }

        for (var i = _currentStackKeys.Count - 1; i >= commonPrefixLength; i--)
        {
            if (_navigationPage.Navigation.NavigationStack.Count <= 1)
            {
                break;
            }

            await _navigationPage.PopAsync(animated: false);
        }

        for (var i = commonPrefixLength; i < desiredStackKeys.Count; i++)
        {
            var page = CreatePageForKey(desiredStackKeys[i], desiredStackKeys);
            await _navigationPage.PushAsync(page, animated: false);
        }

        _currentStackKeys.Clear();
        for (var i = 0; i < desiredStackKeys.Count; i++)
        {
            _currentStackKeys.Add(desiredStackKeys[i]);
        }
    }

    private ContentPage CreateRootPage()
    {
        return new ContentPage
        {
            Title = "Home",
            Content = new StackLayout
            {
                Spacing = 8,
                Children =
                {
                    new Label { Text = "M3 Navigation root page." },
                    new Label { Text = "Push route keys into the URL-backed stack." },
                    CreatePushButton("Push details", "details"),
                    CreatePushButton("Push settings", "settings"),
                    CreatePushButton("Push profile", "profile")
                }
            }
        };
    }

    private ContentPage CreatePageForKey(string pageKey, IReadOnlyList<string> targetStackKeys)
    {
        var pageTitle = GetPageTitle(pageKey);
        return new ContentPage
        {
            Title = pageTitle,
            Content = new StackLayout
            {
                Spacing = 8,
                Children =
                {
                    new Label { Text = $"{pageTitle} page" },
                    new Label { Text = $"Stack route: {BuildRoute(targetStackKeys)}" },
                    CreatePushButton("Push details", "details"),
                    CreatePushButton("Push settings", "settings"),
                    CreatePushButton("Push profile", "profile"),
                    new Button
                    {
                        Text = "Pop current page",
                        Command = new Command(NavigateBackOneLevel)
                    },
                    new Button
                    {
                        Text = "Back to root",
                        Command = new Command(NavigateHome)
                    }
                }
            }
        };
    }

    private ContentPage CreateNotFoundPage(string routeError)
    {
        var message = string.IsNullOrWhiteSpace(routeError)
            ? "Unknown navigation route."
            : routeError;

        return new ContentPage
        {
            Title = "Not Found",
            Content = new StackLayout
            {
                Spacing = 8,
                Children =
                {
                    new Label { Text = "M3 route could not be resolved." },
                    new Label { Text = message },
                    new Button
                    {
                        Text = "Go to /maui",
                        Command = new Command(NavigateHome)
                    }
                }
            }
        };
    }

    private Button CreatePushButton(string text, string pageKey)
    {
        return new Button
        {
            Text = text,
            Command = new Command(() => NavigateToChild(pageKey))
        };
    }

    private void NavigateToChild(string pageKey)
    {
        var normalizedPageKey = pageKey.ToLowerInvariant();
        if (!KnownPageKeys.Contains(normalizedPageKey))
        {
            return;
        }

        if (_currentStackKeys.Count >= MaxStackDepth)
        {
            return;
        }

        var nextStackKeys = new List<string>(_currentStackKeys.Count + 1);
        for (var i = 0; i < _currentStackKeys.Count; i++)
        {
            nextStackKeys.Add(_currentStackKeys[i]);
        }

        nextStackKeys.Add(normalizedPageKey);
        NavigationManager.NavigateTo(BuildRoute(nextStackKeys));
    }

    private void NavigateBackOneLevel()
    {
        if (_currentStackKeys.Count == 0)
        {
            return;
        }

        var nextStackKeys = new List<string>(_currentStackKeys.Count - 1);
        for (var i = 0; i < _currentStackKeys.Count - 1; i++)
        {
            nextStackKeys.Add(_currentStackKeys[i]);
        }

        NavigationManager.NavigateTo(BuildRoute(nextStackKeys));
    }

    private void NavigateHome()
    {
        NavigationManager.NavigateTo("/maui");
    }

    private void OnButtonClicked(object? sender, EventArgs args)
    {
        _clickedCount++;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnButtonCommandExecuted()
    {
        _commandCount++;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnEntryTextChanged(object? sender, TextChangedEventArgs args)
    {
        _entryTextChangeCount++;
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed class CollectionItem
    {
        public CollectionItem(string title, string detail)
        {
            Title = title;
            Detail = detail;
        }

        public string Title { get; }

        public string Detail { get; }
    }
}
