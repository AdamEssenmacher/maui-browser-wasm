<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Maui.Browser.Sample.Demo.ParityLabStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="Margin" Value="0,6,0,10" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Margin" Value="0,6,0,8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="Margin" Value="0,6,0,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="Margin" Value="0,6,0,10" />
        <Setter Property="MinimumHeightRequest" Value="88" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="Margin" Value="0,6,0,10" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="Margin" Value="0,6,0,4" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,6,0,4" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Margin" Value="0,6,0,8" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="Margin" Value="0,6,0,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Margin" Value="0,6,0,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="Margin" Value="0,6,0,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style TargetType="Stepper">
        <Setter Property="Margin" Value="0,6,0,8" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Margin" Value="0,6,0,8" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Margin" Value="0,6,0,8" />
    </Style>

    <Style TargetType="Image">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style TargetType="FlexLayout">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style TargetType="Grid">
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>
</ResourceDictionary>
