<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maui.Browser.Sample.Demo.XamlDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:demo="clr-namespace:Maui.Browser.Sample.Demo"
    Title="MAUI Browser DOM XAML Demo">

    <VerticalStackLayout
        AutomationId="root-stack-container"
        x:Name="RootLayout"
        x:DataType="demo:DemoState"
        Padding="16"
        Spacing="10">

        <Label
            AutomationId="live-text-label"
            FontSize="22"
            Text="{Binding LiveText}"
            TextColor="Black" />

        <Entry
            AutomationId="live-input-entry"
            FontSize="16"
            Placeholder="Type here..."
            Text="{Binding InputText}" />

        <Button
            AutomationId="click-button"
            Clicked="OnIncrementClicked"
            Padding="12,8"
            Text="Click to increment count"
            TextColor="Black" />

        <Label
            AutomationId="click-summary-label"
            FontSize="14"
            Text="{Binding ClickSummary}"
            TextColor="DarkSlateGray" />

        <Button
            AutomationId="nav-open-button"
            Clicked="OnOpenNavigationProbeClicked"
            Padding="12,8"
            Text="Open navigation + scroll page"
            TextColor="Black" />

        <Label
            AutomationId="nav-summary-label"
            FontSize="12"
            Text="{Binding NavigationSummary}"
            TextColor="DarkSlateGray" />

        <Label
            AutomationId="stack-center-alignment-probe"
            FontSize="12"
            HorizontalOptions="Center"
            Margin="24,0,0,0"
            Text="Center alignment probe"
            TextColor="DarkSlateGray" />

        <Label
            AutomationId="viewport-label"
            FontSize="12"
            Text="{Binding ViewportText}"
            TextColor="DarkSlateBlue" />

        <Button
            AutomationId="visibility-button"
            Clicked="OnToggleVisibilityClicked"
            Padding="12,8"
            Text="Toggle probe visibility"
            TextColor="Black" />

        <Button
            AutomationId="opacity-button"
            Clicked="OnCycleOpacityClicked"
            Padding="12,8"
            Text="Cycle probe opacity"
            TextColor="Black" />

        <Label
            x:Name="ProbeLabel"
            AutomationId="probe-label"
            FontSize="15"
            IsVisible="{Binding ProbeIsVisible}"
            Opacity="{Binding ProbeOpacity}"
            Text="Visibility and opacity probe"
            TextColor="DarkBlue" />

        <Label
            AutomationId="probe-visibility-label"
            FontSize="12"
            Text="{Binding ProbeVisibilitySummary}"
            TextColor="DarkSlateGray" />

        <Label
            AutomationId="probe-opacity-label"
            FontSize="12"
            Text="{Binding ProbeOpacitySummary}"
            TextColor="DarkSlateGray" />

        <Label
            AutomationId="form-inputs-heading"
            FontSize="16"
            Text="Form inputs breadth"
            TextColor="Black" />

        <Switch
            AutomationId="form-switch"
            IsToggled="{Binding FormSwitchOn}"
            OnColor="MediumSeaGreen"
            ThumbColor="White" />

        <Label
            AutomationId="form-switch-summary-label"
            FontSize="12"
            Text="{Binding FormSwitchSummary}"
            TextColor="DarkSlateGray" />

        <CheckBox
            AutomationId="form-checkbox"
            Color="SeaGreen"
            IsChecked="{Binding FormCheckBoxChecked}" />

        <Label
            AutomationId="form-checkbox-summary-label"
            FontSize="12"
            Text="{Binding FormCheckBoxSummary}"
            TextColor="DarkSlateGray" />

        <Slider
            AutomationId="form-slider"
            Maximum="100"
            MaximumTrackColor="#CBD5E1"
            Minimum="0"
            MinimumTrackColor="#0EA5E9"
            ThumbColor="#1E293B"
            Value="{Binding FormSliderValue}" />

        <Label
            AutomationId="form-slider-summary-label"
            FontSize="12"
            Text="{Binding FormSliderSummary}"
            TextColor="DarkSlateGray" />

        <Picker
            AutomationId="form-picker"
            ItemsSource="{Binding FormPickerItems}"
            SelectedIndex="{Binding FormPickerSelectedIndex}"
            Title="Pick an item"
            TitleColor="DarkSlateGray" />

        <Label
            AutomationId="form-picker-summary-label"
            FontSize="12"
            Text="{Binding FormPickerSummary}"
            TextColor="DarkSlateGray" />

        <Button
            AutomationId="form-programmatic-button"
            Clicked="OnApplyProgrammaticFormUpdateClicked"
            Padding="12,8"
            Text="Apply programmatic form update"
            TextColor="Black" />

        <Label
            AutomationId="collection-heading"
            FontSize="16"
            Text="CollectionView viability"
            TextColor="Black" />

        <CollectionView
            AutomationId="collection-view"
            HeightRequest="190"
            ItemsSource="{Binding CollectionItems}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="demo:DemoCollectionItem">
                    <Grid
                        AutomationId="collection-item-row"
                        BackgroundColor="#E2E8F0"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="8"
                        Padding="8,6">
                        <Label
                            AutomationId="collection-item-id"
                            FontSize="12"
                            Text="{Binding IdText}"
                            TextColor="DarkSlateGray" />
                        <Label
                            Grid.Column="1"
                            AutomationId="collection-item-title"
                            FontSize="13"
                            Text="{Binding Title}"
                            TextColor="Black" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label
                    AutomationId="collection-empty-view"
                    FontSize="12"
                    Padding="8,6"
                    Text="Collection is empty."
                    TextColor="DarkSlateGray" />
            </CollectionView.EmptyView>
        </CollectionView>

        <Label
            AutomationId="collection-summary-label"
            FontSize="12"
            Text="{Binding CollectionSummary}"
            TextColor="DarkSlateGray" />

        <HorizontalStackLayout
            AutomationId="collection-actions-row"
            Spacing="8">
            <Button
                AutomationId="collection-add-button"
                Clicked="OnCollectionAddClicked"
                Padding="12,8"
                Text="Add item"
                TextColor="Black" />
            <Button
                AutomationId="collection-remove-button"
                Clicked="OnCollectionRemoveClicked"
                Padding="12,8"
                Text="Remove item"
                TextColor="Black" />
            <Button
                AutomationId="collection-clear-button"
                Clicked="OnCollectionClearClicked"
                Padding="12,8"
                Text="Clear items"
                TextColor="Black" />
            <Button
                AutomationId="collection-reset-button"
                Clicked="OnCollectionResetClicked"
                Padding="12,8"
                Text="Reset items"
                TextColor="Black" />
        </HorizontalStackLayout>

        <Label
            AutomationId="core-heading"
            FontSize="16"
            Text="IView core and transform"
            TextColor="Black" />

        <VerticalStackLayout
            AutomationId="core-view-container"
            FlowDirection="{Binding CoreFlowDirection}"
            Spacing="8">

            <Button
                AutomationId="core-flow-direction-button"
                Clicked="OnToggleCoreFlowDirectionClicked"
                Padding="12,8"
                Text="Toggle core flow direction"
                TextColor="Black" />

            <Label
                AutomationId="core-flow-direction-summary-label"
                FontSize="12"
                Text="{Binding CoreFlowDirectionSummary}"
                TextColor="DarkSlateGray" />

            <Button
                AutomationId="core-input-transparent-toggle-button"
                Clicked="OnToggleCoreInputTransparentClicked"
                Padding="12,8"
                Text="Toggle core input transparency"
                TextColor="Black" />

            <Button
                AutomationId="core-input-transparent-probe-button"
                Clicked="OnCoreTransparentProbeClicked"
                InputTransparent="{Binding CoreInputTransparent}"
                Padding="12,8"
                Text="Core input transparency probe"
                TextColor="Black" />

            <Label
                AutomationId="core-input-transparent-summary-label"
                FontSize="12"
                Text="{Binding CoreInputTransparentSummary}"
                TextColor="DarkSlateGray" />

            <Label
                AutomationId="core-input-transparent-click-summary-label"
                FontSize="12"
                Text="{Binding CoreProbeClickSummary}"
                TextColor="DarkSlateGray" />

            <Entry
                x:Name="CoreFocusEntry"
                AutomationId="core-focus-entry"
                FontSize="14"
                Placeholder="Core focus target entry"
                Text="Focus target" />

            <HorizontalStackLayout
                AutomationId="core-focus-row"
                Spacing="8">
                <Button
                    AutomationId="core-focus-button"
                    Clicked="OnFocusCoreEntryClicked"
                    Padding="12,8"
                    Text="Focus core entry"
                    TextColor="Black" />

                <Button
                    AutomationId="core-unfocus-button"
                    Clicked="OnUnfocusCoreEntryClicked"
                    Padding="12,8"
                    Text="Unfocus core entry"
                    TextColor="Black"
                    VerticalOptions="End" />
            </HorizontalStackLayout>

            <Label
                AutomationId="core-transform-probe"
                AnchorX="{Binding CoreAnchorX}"
                AnchorY="{Binding CoreAnchorY}"
                BackgroundColor="{Binding CoreProbeBackground}"
                FontSize="13"
                Rotation="{Binding CoreRotation}"
                RotationX="{Binding CoreRotationX}"
                RotationY="{Binding CoreRotationY}"
                Scale="{Binding CoreScale}"
                SemanticProperties.Description="{Binding CoreSemanticDescription}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Hint="{Binding CoreSemanticHint}"
                Text="{Binding CoreTransformSummary}"
                TextColor="Black"
                TranslationX="{Binding CoreTranslationX}"
                TranslationY="{Binding CoreTranslationY}" />

            <HorizontalStackLayout Spacing="8">
                <Button
                    AutomationId="core-transform-button"
                    Clicked="OnToggleCoreTransformClicked"
                    Padding="12,8"
                    Text="Toggle core transform preset"
                    TextColor="Black" />

                <Button
                    AutomationId="core-background-button"
                    Clicked="OnToggleCoreBackgroundClicked"
                    Padding="12,8"
                    Text="Toggle core background"
                    TextColor="Black" />

                <Button
                    AutomationId="core-semantics-button"
                    Clicked="OnUpdateCoreSemanticsClicked"
                    Padding="12,8"
                    Text="Update core semantics"
                    TextColor="Black" />
            </HorizontalStackLayout>

            <Label
                AutomationId="core-background-summary-label"
                FontSize="12"
                Text="{Binding CoreBackgroundSummary}"
                TextColor="DarkSlateGray" />

            <Label
                AutomationId="core-semantics-summary-label"
                FontSize="12"
                Text="{Binding CoreSemanticsSummary}"
                TextColor="DarkSlateGray" />
        </VerticalStackLayout>

        <Label
            AutomationId="grid-semantics-heading"
            FontSize="16"
            Text="Grid semantics probe"
            TextColor="Black" />

        <Grid
            AutomationId="grid-semantic-container"
            ColumnDefinitions="90,*,2*"
            ColumnSpacing="10"
            Padding="6"
            RowDefinitions="Auto,52,Auto"
            RowSpacing="8">
            <Label
                Grid.Column="0"
                Grid.Row="0"
                AutomationId="grid-r0-c0"
                FontSize="12"
                Text="Grid r0c0"
                TextColor="DarkSlateGray" />
            <Label
                Grid.Column="1"
                Grid.Row="0"
                AutomationId="grid-r0-c1"
                FontSize="12"
                Text="Grid r0c1"
                TextColor="DarkSlateGray" />
            <Label
                Grid.Column="2"
                Grid.Row="0"
                AutomationId="grid-r0-c2"
                FontSize="12"
                Text="Grid r0c2"
                TextColor="DarkSlateGray" />
            <Label
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="1"
                AutomationId="grid-span-center"
                FontSize="12"
                HorizontalOptions="Center"
                Margin="4,0,0,0"
                Text="Grid span center"
                TextColor="DarkSlateGray" />
            <Label
                Grid.Column="2"
                Grid.Row="1"
                AutomationId="grid-align-end"
                FontSize="12"
                HeightRequest="16"
                HorizontalOptions="End"
                Text="Grid align"
                TextColor="DarkSlateGray"
                VerticalOptions="End"
                WidthRequest="60" />
            <Label
                Grid.Column="0"
                Grid.Row="2"
                AutomationId="grid-r2-c0"
                FontSize="12"
                Text="Grid r2c0"
                TextColor="DarkSlateGray" />
        </Grid>

        <AbsoluteLayout
            AutomationId="layout-fallback-absolute"
            HeightRequest="36">
            <Label
                AutomationId="layout-fallback-absolute-child"
                AbsoluteLayout.LayoutBounds="4,4,140,20"
                AbsoluteLayout.LayoutFlags="None"
                FontSize="12"
                Text="Absolute fallback child"
                TextColor="DarkSlateGray" />
        </AbsoluteLayout>
        <Button
            AutomationId="stress-button"
            Clicked="OnStressClicked"
            Padding="12,8"
            Text="Run leak stress"
            TextColor="Black" />

        <Label
            AutomationId="stress-summary-label"
            FontSize="12"
            Text="{Binding StressSummary}"
            TextColor="DarkSlateGray" />

        <VerticalStackLayout
            x:Name="StressHost"
            AutomationId="stress-host"
            Spacing="2" />
    </VerticalStackLayout>
</ContentPage>
