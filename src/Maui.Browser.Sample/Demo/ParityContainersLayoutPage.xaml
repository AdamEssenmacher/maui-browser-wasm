<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maui.Browser.Sample.Demo.ParityContainersLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:DataType="demo:ParityContainersLayoutState"
    xmlns:demo="clr-namespace:Maui.Browser.Sample.Demo"
    AutomationId="showcase-page-containers-layout-depth"
    Title="Containers/Layout Parity">

    <ContentPage.Background>
        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
            <GradientStop Color="{DynamicResource ShowcaseColorPageGradientStart}" Offset="0" />
            <GradientStop Color="{DynamicResource ShowcaseColorPageGradientEnd}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <demo:ShowcaseStyles />
                <demo:ParityLabStyles />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource ShowcaseSecondaryButtonStyle}" />
            <Style TargetType="Label" BasedOn="{StaticResource ShowcaseBaseLabelStyle}" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="24,20,24,28"
            Spacing="14">
            <Label
                AutomationId="parity-containers-core-heading"
                FontSize="20"
                Text="Core View Substrate Parity"
                TextColor="Black" />

            <Label
                AutomationId="parity-containers-core-summary"
                FontSize="12"
                Text="Clip (rectangle/round-rectangle), shadow (solid), and linear-gradient background probes."
                TextColor="DarkSlateGray" />

            <Grid
                x:Name="CoreSubstrateProbe"
                AutomationId="parity-core-substrate-probe"
                BackgroundColor="LightSkyBlue"
                HeightRequest="130"
                HorizontalOptions="Start"
                WidthRequest="240">
                <Label
                    AutomationId="parity-core-substrate-probe-text"
                    HorizontalOptions="Center"
                    Text="Core substrate probe"
                    TextColor="Black"
                    VerticalOptions="Center" />
            </Grid>

            <Label
                AutomationId="parity-core-clip-heading"
                FontSize="14"
                Text="Clip modes"
                TextColor="Black" />

            <HorizontalStackLayout Spacing="8">
                <Button
                    AutomationId="parity-core-clip-none-button"
                    Clicked="OnClipNoneClicked"
                    Padding="10,6"
                    Text="None"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-core-clip-rectangle-button"
                    Clicked="OnClipRectangleClicked"
                    Padding="10,6"
                    Text="Rectangle"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-core-clip-round-button"
                    Clicked="OnClipRoundRectangleClicked"
                    Padding="10,6"
                    Text="RoundRect"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-core-clip-unsupported-button"
                    Clicked="OnClipUnsupportedClicked"
                    Padding="10,6"
                    Text="Unsupported"
                    TextColor="Black" />
            </HorizontalStackLayout>

            <Label
                AutomationId="parity-core-clip-summary"
                FontSize="12"
                Text="{Binding ClipSummary}"
                TextColor="DarkSlateGray" />

            <Label
                AutomationId="parity-core-shadow-heading"
                FontSize="14"
                Text="Shadow modes"
                TextColor="Black" />

            <HorizontalStackLayout Spacing="8">
                <Button
                    AutomationId="parity-core-shadow-off-button"
                    Clicked="OnShadowOffClicked"
                    Padding="10,6"
                    Text="Off"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-core-shadow-on-button"
                    Clicked="OnShadowOnClicked"
                    Padding="10,6"
                    Text="Solid"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-core-shadow-unsupported-button"
                    Clicked="OnShadowUnsupportedClicked"
                    Padding="10,6"
                    Text="Unsupported"
                    TextColor="Black" />
            </HorizontalStackLayout>

            <Label
                AutomationId="parity-core-shadow-summary"
                FontSize="12"
                Text="{Binding ShadowSummary}"
                TextColor="DarkSlateGray" />

            <Label
                AutomationId="parity-core-background-heading"
                FontSize="14"
                Text="Background modes"
                TextColor="Black" />

            <HorizontalStackLayout Spacing="8">
                <Button
                    AutomationId="parity-core-background-solid-button"
                    Clicked="OnBackgroundSolidClicked"
                    Padding="10,6"
                    Text="Solid"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-core-background-linear-button"
                    Clicked="OnBackgroundLinearClicked"
                    Padding="10,6"
                    Text="Linear"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-core-background-unsupported-button"
                    Clicked="OnBackgroundUnsupportedClicked"
                    Padding="10,6"
                    Text="Unsupported"
                    TextColor="Black" />
            </HorizontalStackLayout>

            <Label
                AutomationId="parity-core-background-summary"
                FontSize="12"
                Text="{Binding BackgroundSummary}"
                TextColor="DarkSlateGray" />

            <Label
                AutomationId="parity-flex-heading"
                FontSize="18"
                Text="FlexLayout semantic projection"
                TextColor="Black" />

            <Label
                AutomationId="parity-flex-summary"
                FontSize="12"
                Text="Direction/wrap/justify/align plus attached item properties."
                TextColor="DarkSlateGray" />

            <FlexLayout
                x:Name="FlexSemanticProbe"
                AutomationId="parity-flex-container"
                AlignContent="Start"
                AlignItems="Stretch"
                BackgroundColor="#E2E8F0"
                Direction="Row"
                HeightRequest="180"
                JustifyContent="Start"
                Padding="8"
                WidthRequest="420"
                Wrap="NoWrap">
                <Label
                    x:Name="FlexItemOne"
                    AutomationId="parity-flex-item-1"
                    BackgroundColor="#BFDBFE"
                    HeightRequest="44"
                    Padding="8,6"
                    Text="Item 1"
                    WidthRequest="92" />
                <Label
                    x:Name="FlexItemTwo"
                    AutomationId="parity-flex-item-2"
                    BackgroundColor="#FBCFE8"
                    HeightRequest="44"
                    Padding="8,6"
                    Text="Item 2"
                    WidthRequest="92" />
                <Label
                    x:Name="FlexItemThree"
                    AutomationId="parity-flex-item-3"
                    BackgroundColor="#BBF7D0"
                    HeightRequest="44"
                    Padding="8,6"
                    Text="Item 3"
                    WidthRequest="92" />
            </FlexLayout>

            <HorizontalStackLayout Spacing="8">
                <Button
                    AutomationId="parity-flex-toggle-direction-button"
                    Clicked="OnFlexToggleDirectionClicked"
                    Padding="10,6"
                    Text="Toggle direction"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-flex-toggle-wrap-button"
                    Clicked="OnFlexToggleWrapClicked"
                    Padding="10,6"
                    Text="Toggle wrap"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-flex-toggle-justify-button"
                    Clicked="OnFlexToggleJustifyClicked"
                    Padding="10,6"
                    Text="Toggle justify"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-flex-toggle-align-button"
                    Clicked="OnFlexToggleAlignClicked"
                    Padding="10,6"
                    Text="Toggle align"
                    TextColor="Black" />
                <Button
                    AutomationId="parity-flex-toggle-item-preset-button"
                    Clicked="OnFlexToggleItemPresetClicked"
                    Padding="10,6"
                    Text="Toggle item preset"
                    TextColor="Black" />
            </HorizontalStackLayout>

            <Label
                AutomationId="parity-flex-direction-summary"
                FontSize="12"
                Text="{Binding FlexDirectionSummary}"
                TextColor="DarkSlateGray" />
            <Label
                AutomationId="parity-flex-wrap-summary"
                FontSize="12"
                Text="{Binding FlexWrapSummary}"
                TextColor="DarkSlateGray" />
            <Label
                AutomationId="parity-flex-justify-summary"
                FontSize="12"
                Text="{Binding FlexJustifySummary}"
                TextColor="DarkSlateGray" />
            <Label
                AutomationId="parity-flex-align-summary"
                FontSize="12"
                Text="{Binding FlexAlignSummary}"
                TextColor="DarkSlateGray" />
            <Label
                AutomationId="parity-flex-item-preset-summary"
                FontSize="12"
                Text="{Binding FlexItemPresetSummary}"
                TextColor="DarkSlateGray" />

            <Button
                AutomationId="showcase-page-containers-layout-depth-open-control-lab"
                Clicked="OnOpenConsolidatedClicked"
                Padding="12,8"
                Text="Open consolidated demo probes"
                TextColor="Black" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
