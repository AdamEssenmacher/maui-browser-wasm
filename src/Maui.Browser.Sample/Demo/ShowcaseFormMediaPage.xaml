<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maui.Browser.Sample.Demo.ShowcaseFormMediaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:DataType="demo:ShowcaseFormMediaState"
    xmlns:demo="clr-namespace:Maui.Browser.Sample.Demo"
    AutomationId="showcase-page-form-media"
    Title="Showcase Form/Media">

    <ContentPage.Background>
        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
            <GradientStop Color="{DynamicResource ShowcaseColorPageGradientStart}" Offset="0" />
            <GradientStop Color="{DynamicResource ShowcaseColorPageGradientEnd}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <demo:ShowcaseStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30,26,30,36" Spacing="18">
            <HorizontalStackLayout Spacing="12">
                <Button
                    AutomationId="showcase-form-back-home"
                    Clicked="OnBackClicked"
                    Style="{StaticResource ShowcaseGhostButtonStyle}"
                    Text="Back" />
                <Button
                    AutomationId="showcase-form-toggle-theme"
                    Clicked="OnToggleThemeClicked"
                    Style="{StaticResource ShowcaseSecondaryButtonStyle}"
                    Text="Toggle theme" />
            </HorizontalStackLayout>

            <Label
                AutomationId="showcase-form-heading"
                Style="{StaticResource ShowcasePageHeadingStyle}"
                Text="Form controls and media" />

            <Border Style="{StaticResource ShowcaseCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource ShowcaseSectionHeadingStyle}" Text="Form controls" />

                    <Switch
                        AutomationId="showcase-form-switch"
                        IsToggled="{Binding SwitchOn}" />
                    <CheckBox
                        AutomationId="showcase-form-checkbox"
                        IsChecked="{Binding CheckBoxChecked}" />
                    <Slider
                        AutomationId="showcase-form-slider"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding SliderValue}" />
                    <Picker
                        AutomationId="showcase-form-picker"
                        ItemsSource="{Binding PickerItems}"
                        SelectedIndex="{Binding PickerIndex}"
                        Title="Choose stage" />

                    <Label
                        AutomationId="showcase-form-summary"
                        Style="{StaticResource ShowcaseMutedLabelStyle}"
                        Text="{Binding FormSummary}" />

                    <HorizontalStackLayout Spacing="12">
                        <Button
                            AutomationId="showcase-form-apply-programmatic"
                            Clicked="OnApplyProgrammaticClicked"
                            Style="{StaticResource ShowcasePrimaryButtonStyle}"
                            Text="Apply programmatic" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ShowcaseCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource ShowcaseSectionHeadingStyle}" Text="Media details" />

                    <Grid ColumnDefinitions="220,*" ColumnSpacing="14">
                        <Image
                            x:Name="MediaImage"
                            AutomationId="showcase-media-image"
                            BackgroundColor="{DynamicResource ShowcaseColorSurfaceAlt}"
                            HeightRequest="150"
                            WidthRequest="220" />

                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Label
                                AutomationId="showcase-media-source-summary"
                                Style="{StaticResource ShowcaseMutedLabelStyle}"
                                Text="{Binding SourceSummary}" />
                            <Label
                                AutomationId="showcase-media-aspect-summary"
                                Style="{StaticResource ShowcaseMutedLabelStyle}"
                                Text="{Binding AspectSummary}" />

                            <HorizontalStackLayout Spacing="10">
                                <Button
                                    AutomationId="showcase-media-cycle-source"
                                    Clicked="OnCycleSourceClicked"
                                    Style="{StaticResource ShowcaseSecondaryButtonStyle}"
                                    Text="Cycle source" />
                                <Button
                                    AutomationId="showcase-media-toggle-aspect"
                                    Clicked="OnToggleAspectClicked"
                                    Style="{StaticResource ShowcaseSecondaryButtonStyle}"
                                    Text="Toggle aspect" />
                            </HorizontalStackLayout>

                            <ImageButton
                                x:Name="MediaImageButton"
                                AutomationId="showcase-media-imagebutton"
                                BackgroundColor="{DynamicResource ShowcaseColorAccentSoft}"
                                BorderColor="{DynamicResource ShowcaseColorAccent}"
                                BorderWidth="1.5"
                                Clicked="OnImageButtonClicked"
                                CornerRadius="12"
                                HeightRequest="72"
                                Padding="8"
                                WidthRequest="72" />
                            <Label
                                AutomationId="showcase-media-imagebutton-summary"
                                Style="{StaticResource ShowcaseMutedLabelStyle}"
                                Text="{Binding ImageButtonSummary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border
                        AutomationId="showcase-media-border"
                        BackgroundColor="{DynamicResource ShowcaseColorAccentSoft}"
                        Padding="12"
                        Stroke="{DynamicResource ShowcaseColorAccent}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 14">
                        <Label Text="Border projection showcase" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button
                AutomationId="showcase-form-open-layout-collection"
                Clicked="OnOpenLayoutCollectionClicked"
                Style="{StaticResource ShowcasePrimaryButtonStyle}"
                Text="Open layout/collection" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
