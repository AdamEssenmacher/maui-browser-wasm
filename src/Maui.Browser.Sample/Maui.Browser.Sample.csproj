<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <DefaultWasmHostConfig>browser</DefaultWasmHostConfig>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <WasmEnableJSImport>true</WasmEnableJSImport>

    <!-- Produce a static web site output -->
    <WasmBuildAppBundle>true</WasmBuildAppBundle>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
  </PropertyGroup>

  <ItemGroup>
    <HostConfig Include="browser">
      <host>browser</host>
      <html-path>index.html</html-path>
    </HostConfig>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maui.Browser\Maui.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Demo/ParityLabStyles.xaml" />
    <MauiXaml Update="Demo/XamlDemoPage.xaml" />
    <MauiXaml Update="Demo/ParityContainersLayoutPage.xaml" />
    <MauiXaml Update="Demo/ParityTextInputPage.xaml" />
    <MauiXaml Update="Demo/ParityLabelPage.xaml" />
    <MauiXaml Update="Demo/ParityPickersDateTimePage.xaml" />
    <MauiXaml Update="Demo/ParityMediaVisualPage.xaml" />
    <MauiXaml Update="Demo/ShowcaseStyles.xaml" />
    <MauiXaml Update="Demo/ShowcaseHomePage.xaml" />
    <MauiXaml Update="Demo/ShowcaseTextInputPage.xaml" />
    <MauiXaml Update="Demo/ShowcaseFormMediaPage.xaml" />
    <MauiXaml Update="Demo/ShowcaseLayoutCollectionPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="$(MauiPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wwwroot\dom.js" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot\**\*.*">
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </WasmExtraFilesToDeploy>
    <WasmExtraFilesToDeploy Include="wwwroot\dom.js">
      <TargetPath>_framework/dom.js</TargetPath>
    </WasmExtraFilesToDeploy>
  </ItemGroup>

</Project>
