<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- This project produces a NuGet that contains an MSBuild SDK layout:
         /Sdk/Sdk.props and /Sdk/Sdk.targets. -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageType>MSBuildSdk</PackageType>

    <PackageId>MauiBrowser.Sdk</PackageId>
    <Title>MauiBrowser.Sdk</Title>
    <Description>MSBuild SDK for MAUI Browser/WASM hosted in Blazor WebAssembly.</Description>
    <PackageTags>maui;blazor;wasm;msbuild;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>Sdk/README.md</PackageReadmeFile>

    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk\Sdk.props" />
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk\Sdk.targets" />
    <None Include="Sdk\README.md" Pack="true" PackagePath="Sdk\README.md" />
  </ItemGroup>

</Project>
