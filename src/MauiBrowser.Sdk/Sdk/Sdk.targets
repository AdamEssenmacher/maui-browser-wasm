<Project>
  <Import Sdk="Microsoft.NET.Sdk.BlazorWebAssembly" Project="Sdk.targets" />

  <Target Name="ValidateMauiBrowserSdkTargetFramework" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(MauiBrowserValidateTargetFramework)' == 'true' and '$(TargetFrameworks)' != ''"
      Text="MauiBrowser.Sdk currently supports a single TargetFramework. Use TargetFramework='$(MauiBrowserRequiredTargetFramework)'." />
    <Error
      Condition="'$(MauiBrowserValidateTargetFramework)' == 'true' and '$(TargetFramework)' != '' and '$(TargetFramework)' != '$(MauiBrowserRequiredTargetFramework)'"
      Text="MauiBrowser.Sdk currently requires TargetFramework='$(MauiBrowserRequiredTargetFramework)'. Current value: '$(TargetFramework)'." />
  </Target>

  <ItemGroup Condition="'$(MauiBrowserRuntimeProjectPath)' != ''">
    <ProjectReference Include="$(MauiBrowserRuntimeProjectPath)" />
  </ItemGroup>

  <ItemGroup
    Condition="'$(MauiBrowserEnableImplicitRuntimeReference)' == 'true'
      and '$(MauiBrowserRuntimeProjectPath)' == ''
      and '$(MauiBrowserRuntimePackageId)' != ''
      and '$(MauiBrowserRuntimeVersion)' != ''">
    <PackageReference Include="$(MauiBrowserRuntimePackageId)" Version="$(MauiBrowserRuntimeVersion)" />
  </ItemGroup>
</Project>
