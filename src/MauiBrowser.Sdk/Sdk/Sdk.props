<Project>
  <Import Sdk="Microsoft.NET.Sdk.BlazorWebAssembly" Project="Sdk.props" />

  <PropertyGroup>
    <MauiBrowserSdkPackageRoot>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(MSBuildThisFileFullPath)'))))</MauiBrowserSdkPackageRoot>
    <MauiBrowserSdkVersionCandidate>$([System.IO.Path]::GetFileName('$(MauiBrowserSdkPackageRoot)'))</MauiBrowserSdkVersionCandidate>
    <MauiBrowserSdkVersion
      Condition="'$(MauiBrowserSdkVersion)' == ''
        and $([System.Text.RegularExpressions.Regex]::IsMatch('$(MauiBrowserSdkVersionCandidate)', '^\d+\.\d+\.\d+([-+].*)?$'))">$(MauiBrowserSdkVersionCandidate)</MauiBrowserSdkVersion>
    <MauiBrowserRuntimePackageId Condition="'$(MauiBrowserRuntimePackageId)' == ''">MauiBrowser.Runtime</MauiBrowserRuntimePackageId>
    <MauiBrowserRuntimeVersion Condition="'$(MauiBrowserRuntimeVersion)' == ''">$(MauiBrowserSdkVersion)</MauiBrowserRuntimeVersion>
    <MauiBrowserEnableImplicitRuntimeReference Condition="'$(MauiBrowserEnableImplicitRuntimeReference)' == ''">true</MauiBrowserEnableImplicitRuntimeReference>
    <MauiBrowserRuntimeProjectPath Condition="'$(MauiBrowserRuntimeProjectPath)' == ''"></MauiBrowserRuntimeProjectPath>
    <MauiBrowserValidateTargetFramework Condition="'$(MauiBrowserValidateTargetFramework)' == ''">true</MauiBrowserValidateTargetFramework>
    <MauiBrowserRequiredTargetFramework Condition="'$(MauiBrowserRequiredTargetFramework)' == ''">net10.0</MauiBrowserRequiredTargetFramework>
  </PropertyGroup>
</Project>
